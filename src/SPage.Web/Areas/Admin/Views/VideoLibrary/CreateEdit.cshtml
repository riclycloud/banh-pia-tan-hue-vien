@model VideoFormModel
@using SPage.Domain.Enums
@{
    var isEdit = Model.Id > 0;
    ViewData["Title"] = isEdit ? "Sửa video" : "Thêm video";
}

<div class="p-6 max-w-4xl mx-auto">

  @* Breadcrumb *@
  <div class="flex items-center gap-2 mb-5 text-sm text-slate-500">
    <a asp-action="Index" class="hover:text-blue-600">Thư viện Video</a>
    <span>/</span>
    <span class="text-slate-800 font-medium">@ViewData["Title"]</span>
  </div>

  @if (TempData["Success"] is string s)
  {
    <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl">@s</div>
  }

  <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      @* ── Main Column ── *@
      <div class="lg:col-span-2 space-y-5">

        @* URL paste + auto-detect *@
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
          <h3 class="text-sm font-semibold text-slate-700 mb-4">Thông tin video</h3>

          <div class="mb-4">
            <label class="block text-xs font-medium text-slate-500 mb-1.5">URL Video <span class="text-red-400">*</span></label>
            <input id="video-url" asp-for="VideoUrl"
                   placeholder="Paste URL YouTube / Facebook / TikTok..."
                   class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            <p class="text-xs text-slate-400 mt-1">VideoId, Platform và Thumbnail sẽ tự động điền.</p>
            <span asp-validation-for="VideoUrl" class="text-xs text-red-500"></span>
          </div>

          <div class="grid grid-cols-2 gap-4 mb-4">
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1.5">Platform</label>
              <select id="platform-select" asp-for="Platform"
                      class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500">
                @foreach (var p in Enum.GetValues<VideoPlatform>())
                {
                  <option value="@((int)p)">@p.ToString()</option>
                }
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1.5">Video ID</label>
              <input id="video-id" asp-for="VideoId"
                     class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"/>
            </div>
          </div>

          <div class="mb-4">
            <label class="block text-xs font-medium text-slate-500 mb-1.5">Tiêu đề <span class="text-red-400">*</span></label>
            <input asp-for="Title"
                   class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            <span asp-validation-for="Title" class="text-xs text-red-500"></span>
          </div>

          <div class="mb-4">
            <label class="block text-xs font-medium text-slate-500 mb-1.5">Mô tả</label>
            <textarea asp-for="Description" rows="3"
                      class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 resize-y"></textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1.5">Thời lượng <span class="text-slate-300">(VD: PT3M45S)</span></label>
              <input asp-for="Duration" placeholder="PT3M45S"
                     class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"/>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1.5">Tags <span class="text-slate-300">(cách nhau bằng dấu phẩy)</span></label>
              <input asp-for="TagsCsv" placeholder="marketing,tvc,2025"
                     class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
          </div>
        </div>

        @* Thumbnail *@
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
          <h3 class="text-sm font-semibold text-slate-700 mb-4">Thumbnail</h3>
          <div class="flex gap-4 items-start">
            <div id="thumb-preview" class="w-32 h-20 rounded-xl overflow-hidden bg-slate-100 shrink-0 border border-slate-200">
              @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
              {
                <img src="@Model.ThumbnailUrl" class="w-full h-full object-cover" loading="lazy"/>
              }
              else if (!string.IsNullOrEmpty(Model.VideoId) && Model.Platform == VideoPlatform.YouTube)
              {
                <img src="https://img.youtube.com/vi/@Model.VideoId/mqdefault.jpg" class="w-full h-full object-cover" loading="lazy"/>
              }
              else
              {
                <div class="w-full h-full flex items-center justify-center text-slate-300 text-xs">No thumb</div>
              }
            </div>
            <div class="flex-1">
              <label class="block text-xs font-medium text-slate-500 mb-1.5">URL thumbnail (để trống = auto từ YouTube)</label>
              <input id="thumbnail-url" asp-for="ThumbnailUrl" placeholder="https://... hoặc để trống"
                     class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
              <p class="text-xs text-slate-400 mt-1">YouTube sẽ tự điền. Facebook/TikTok cần nhập thủ công.</p>
            </div>
          </div>
        </div>

        @* Embed Preview *@
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-semibold text-slate-700">Xem trước</h3>
            <button type="button" id="btn-preview"
                    class="text-xs text-blue-600 hover:underline">Cập nhật xem trước</button>
          </div>
          <div id="embed-container" class="relative w-full rounded-xl overflow-hidden bg-slate-900" style="aspect-ratio:16/9">
            <div id="embed-placeholder" class="absolute inset-0 flex items-center justify-center text-slate-500 text-sm">
              ▶ Nhập Video ID để xem trước
            </div>
            <iframe id="embed-iframe" src="" class="absolute inset-0 w-full h-full border-0" style="display:none"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen>
            </iframe>
          </div>
        </div>

        @* SEO Accordion *@
        <details class="bg-white rounded-2xl shadow-sm border border-slate-100">
          <summary class="px-5 py-4 text-sm font-semibold text-slate-700 cursor-pointer list-none flex items-center justify-between">
            SEO
            <svg class="w-4 h-4 text-slate-400 transition-transform details-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-5 pb-5 border-t border-slate-100 space-y-4 pt-4">
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1.5">Slug URL</label>
              <input asp-for="Slug" placeholder="tu-dong-tao-tu-tieu-de"
                     class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl font-mono focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1.5">Meta Title <span class="text-slate-300">(≤70 ký tự)</span></label>
              <input asp-for="MetaTitle" maxlength="200"
                     class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-500 mb-1.5">Meta Description <span class="text-slate-300">(≤160 ký tự)</span></label>
              <textarea asp-for="MetaDescription" rows="2" maxlength="500"
                        class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl resize-none focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" asp-for="IsIndexable" class="w-4 h-4 rounded border-slate-300 text-blue-600"/>
              <span class="text-sm text-slate-600">Cho phép Google index</span>
            </label>
          </div>
        </details>

      </div>

      @* ── Sidebar ── *@
      <div class="space-y-4">

        @* Publish settings *@
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 space-y-4">
          <h3 class="text-sm font-semibold text-slate-700">Xuất bản</h3>

          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" asp-for="IsPublished" class="w-4 h-4 rounded border-slate-300 text-green-600"/>
            <span class="text-sm text-slate-700">Xuất bản công khai</span>
          </label>
          <label class="flex items-center gap-3 cursor-pointer">
            <input type="checkbox" asp-for="IsFeatured" class="w-4 h-4 rounded border-slate-300 text-amber-500"/>
            <span class="text-sm text-slate-700">Đánh dấu nổi bật ★</span>
          </label>

          <div>
            <label class="block text-xs font-medium text-slate-500 mb-1.5">Danh mục</label>
            <select asp-for="CategoryId"
                    class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">— Không chọn —</option>
              @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.Categories)
              {
                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
              }
            </select>
          </div>

          <div class="flex gap-2 pt-2 border-t border-slate-100">
            <button type="submit"
                    class="flex-1 px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl transition-colors">
              @(isEdit ? "Lưu thay đổi" : "Thêm video")
            </button>
            <a asp-action="Index" class="px-4 py-2.5 border border-slate-200 hover:bg-slate-50 text-slate-600 text-sm rounded-xl transition-colors">
              Hủy
            </a>
          </div>
        </div>

        @if (isEdit)
        {
          <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
            <h3 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Xem trang</h3>
            <a href="/video/@Model.Slug" target="_blank"
               class="flex items-center gap-2 text-sm text-blue-600 hover:underline">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
              /video/@Model.Slug
            </a>
          </div>
        }

      </div>
    </div>
  </form>
</div>

@section Scripts {
<script>
(function () {
    var urlInput   = document.getElementById('video-url');
    var platformSel= document.getElementById('platform-select');
    var videoIdInp = document.getElementById('video-id');
    var thumbInp   = document.getElementById('thumbnail-url');
    var thumbPrev  = document.getElementById('thumb-preview');
    var embedIframe= document.getElementById('embed-iframe');
    var embedPH    = document.getElementById('embed-placeholder');
    var btnPreview = document.getElementById('btn-preview');

    // ── Parse URL on paste / change ──────────────────────────────────────
    urlInput.addEventListener('change', parseUrl);
    urlInput.addEventListener('paste', function () { setTimeout(parseUrl, 50); });

    function parseUrl() {
        var url = urlInput.value.trim();
        if (!url) return;

        var platform = detectPlatform(url);
        var id       = extractId(platform, url);

        if (platform !== null) platformSel.value = String(platform);
        if (id)               videoIdInp.value  = id;

        updateThumb(platform, id, thumbInp.value);
        updatePreview(platform, id, url);
    }

    function detectPlatform(url) {
        var l = url.toLowerCase();
        if (l.includes('youtube.com') || l.includes('youtu.be')) return 0; // YouTube
        if (l.includes('facebook.com') || l.includes('fb.watch')) return 1; // Facebook
        if (l.includes('tiktok.com'))                              return 2; // TikTok
        return null;
    }

    function extractId(platform, url) {
        try {
            if (platform === 0) { // YouTube
                if (url.includes('youtu.be/')) return url.split('youtu.be/')[1].split('?')[0];
                if (url.includes('/shorts/'))  return url.split('/shorts/')[1].split('?')[0];
                var u = new URL(url);
                return u.searchParams.get('v') || '';
            }
            if (platform === 2) { // TikTok
                if (url.includes('/video/')) return url.split('/video/')[1].split('?')[0];
            }
            if (platform === 1) { // Facebook
                if (url.includes('/videos/')) return url.split('/videos/')[1].replace(/\/$/, '').split('?')[0];
                var fu = new URL(url);
                return fu.searchParams.get('video_id') || fu.searchParams.get('v') || url;
            }
        } catch {}
        return '';
    }

    // ── Thumbnail auto-fill ───────────────────────────────────────────────
    videoIdInp.addEventListener('input', function () {
        if (!thumbInp.value) updateThumb(parseInt(platformSel.value), videoIdInp.value, '');
    });
    thumbInp.addEventListener('input', function () { previewThumb(thumbInp.value); });

    function updateThumb(platform, id, override) {
        if (override) { previewThumb(override); return; }
        if (platform === 0 && id) {
            var url = 'https://img.youtube.com/vi/' + id + '/mqdefault.jpg';
            previewThumb(url);
        }
    }

    function previewThumb(url) {
        thumbPrev.innerHTML = url
            ? '<img src="' + url + '" class="w-full h-full object-cover" onerror="this.style.display=\'none\'">'
            : '<div class="w-full h-full flex items-center justify-center text-slate-300 text-xs">No thumb</div>';
    }

    // ── Embed preview ──────────────────────────────────────────────────────
    btnPreview.addEventListener('click', function () {
        var platform = parseInt(platformSel.value);
        var id       = videoIdInp.value.trim();
        var rawUrl   = urlInput.value.trim();
        updatePreview(platform, id, rawUrl);
    });

    // Auto-preview on videoId change
    videoIdInp.addEventListener('change', function () {
        updatePreview(parseInt(platformSel.value), videoIdInp.value.trim(), urlInput.value.trim());
    });

    function updatePreview(platform, id, rawUrl) {
        if (!id && !rawUrl) return;
        var src = '';
        if (platform === 0 && id) src = 'https://www.youtube.com/embed/' + id + '?rel=0&modestbranding=1';
        else if (platform === 2 && id) src = 'https://www.tiktok.com/embed/v2/' + id;
        else if (platform === 1 && rawUrl) src = 'https://www.facebook.com/plugins/video.php?href=' + encodeURIComponent(rawUrl) + '&show_text=0&width=560';

        if (src) {
            embedIframe.src = src;
            embedIframe.style.display = '';
            embedPH.style.display = 'none';
        }
    }
})();
</script>
}
