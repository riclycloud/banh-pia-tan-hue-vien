@using SPage.Application.Features.VideoLibrary.DTOs
@using SPage.Domain.Enums
@model List<VideoSummaryDto>
@{
    ViewData["Title"] = "Thư viện Video";
    string PlatformBadge(VideoPlatform p) => p switch {
        VideoPlatform.YouTube  => "<span class=\"inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-semibold rounded-full bg-red-100 text-red-700\">▶ YouTube</span>",
        VideoPlatform.Facebook => "<span class=\"inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-semibold rounded-full bg-blue-100 text-blue-700\">f Facebook</span>",
        VideoPlatform.TikTok   => "<span class=\"inline-flex items-center gap-1 px-2 py-0.5 text-[11px] font-semibold rounded-full bg-slate-900 text-white\">♪ TikTok</span>",
        _                      => p.ToString()
    };
    string ThumbUrl(VideoSummaryDto v) => !string.IsNullOrEmpty(v.ThumbnailUrl) ? v.ThumbnailUrl
        : v.Platform == VideoPlatform.YouTube ? $"https://img.youtube.com/vi/{v.VideoId}/mqdefault.jpg"
        : "/img/video-placeholder.svg";
}

<div class="p-6 max-w-screen-xl mx-auto">

  @* Header *@
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Thư viện Video</h1>
      <p class="text-sm text-slate-500 mt-0.5">@Model.Count video</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
      </svg>
      Thêm video
    </a>
  </div>

  @if (TempData["Success"] is string s)
  {
    <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl">@s</div>
  }

  @* Filters *@
  <form method="get" class="flex flex-wrap gap-3 mb-5">
    <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm tiêu đề, Video ID..."
           class="px-3 py-2 text-sm border border-slate-200 rounded-lg w-60 focus:outline-none focus:ring-2 focus:ring-blue-400"/>
    <select name="categoryId" class="px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
      <option value="">Tất cả danh mục</option>
      @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.Categories)
      {
        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
      }
    </select>
    <select name="platform" class="px-3 py-2 text-sm border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
      <option value="">Tất cả platform</option>
      @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.Platforms)
      {
        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
      }
    </select>
    <button type="submit" class="px-4 py-2 bg-slate-700 hover:bg-slate-800 text-white text-sm rounded-lg transition-colors">Lọc</button>
    <a asp-action="Index" class="px-4 py-2 border border-slate-200 hover:bg-slate-50 text-slate-600 text-sm rounded-lg transition-colors">Xóa bộ lọc</a>
  </form>

  @* Table *@
  <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
    @if (!Model.Any())
    {
      <div class="text-center py-20 text-slate-400">
        <svg class="w-14 h-14 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 10l4.553-2.069A1 1 0 0121 8.82v6.36a1 1 0 01-1.447.893L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
        </svg>
        <p class="font-medium">Chưa có video nào</p>
        <a asp-action="Create" class="mt-3 inline-block text-sm text-blue-600 hover:underline">Thêm video đầu tiên</a>
      </div>
    }
    else
    {
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-100">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide w-16">Thumb</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Tiêu đề</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Platform</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Danh mục</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wide">Trạng thái</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wide">Nổi bật</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wide">Lượt xem</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wide">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          @foreach (var v in Model)
          {
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-2">
                <img src="@ThumbUrl(v)" alt="@v.Title"
                     class="w-16 h-10 object-cover rounded-lg bg-slate-100"
                     loading="lazy" onerror="this.src='/img/video-placeholder.svg'"/>
              </td>
              <td class="px-4 py-2">
                <p class="font-medium text-slate-800 line-clamp-1">@v.Title</p>
                <p class="text-[11px] text-slate-400 font-mono mt-0.5">@v.VideoId</p>
              </td>
              <td class="px-4 py-2">@Html.Raw(PlatformBadge(v.Platform))</td>
              <td class="px-4 py-2 text-slate-500 text-xs">@(v.CategoryName ?? "—")</td>
              <td class="px-4 py-2 text-center">
                @if (v.IsPublished)
                {
                  <span class="inline-block px-2 py-0.5 text-[11px] font-medium rounded-full bg-green-100 text-green-700">Published</span>
                }
                else
                {
                  <span class="inline-block px-2 py-0.5 text-[11px] font-medium rounded-full bg-amber-100 text-amber-700">Draft</span>
                }
              </td>
              <td class="px-4 py-2 text-center">
                @if (v.IsFeatured) { <span class="text-amber-400 text-base">★</span> }
              </td>
              <td class="px-4 py-2 text-right text-slate-500">@v.ViewCount.ToString("N0")</td>
              <td class="px-4 py-2 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a asp-action="Edit" asp-route-id="@v.Id"
                     class="text-blue-600 hover:text-blue-800 text-xs font-medium">Sửa</a>
                  <form asp-action="Delete" asp-route-id="@v.Id" method="post"
                        onsubmit="return confirm('Xóa video này?')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-medium">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    }
  </div>
</div>
