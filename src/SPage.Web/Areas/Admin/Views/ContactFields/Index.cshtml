@using SPage.Domain.Entities.Contact
@model IEnumerable<ContactField>
@{
 ViewData["Title"] = "Trường form liên hệ";
}

<div class="flex items-center justify-between mb-4">
 <div>
 <h2 class="text-xl font-bold text-gray-800 ">Trường form liên hệ</h2>
 <p class="mt-1 text-sm text-gray-500 ">
 Quản lý các field của form liên hệ (Họ tên, Số điện thoại, Địa chỉ, Nội dung,...).
 </p>
 </div>
 <a asp-action="Edit" class="px-4 py-2 text-sm text-white bg-primary-600 rounded-lg hover:bg-primary-700">
 + Thêm trường
 </a>
</div>

<div class="relative overflow-x-auto shadow rounded-lg">
 <table class="w-full text-sm text-left text-gray-500 ">
 <thead class="text-xs text-gray-700 uppercase bg-gray-50 ">
 <tr>
 <th class="px-4 py-3">Nhãn</th>
 <th class="px-4 py-3">Tên (name)</th>
 <th class="px-4 py-3">Loại</th>
 <th class="px-4 py-3 text-center">Bắt buộc</th>
 <th class="px-4 py-3 text-center">Hiển thị</th>
 <th class="px-4 py-3 text-center">Thứ tự</th>
 <th class="px-4 py-3 text-right">Thao tác</th>
 </tr>
 </thead>
 <tbody>
 @foreach (var f in Model)
 {
 <tr class="bg-white border-b hover:bg-gray-50 :bg-gray-700">
 <td class="px-4 py-3 font-medium text-gray-900 ">@f.Label</td>
 <td class="px-4 py-3 font-mono text-xs text-gray-500">@f.Name</td>
 <td class="px-4 py-3">@f.FieldType</td>
 <td class="px-4 py-3 text-center">
 @if (f.IsRequired)
 {
 <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 text-red-700">Bắt buộc</span>
 }
 else
 {
 <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-600">Tùy chọn</span>
 }
 </td>
 <td class="px-4 py-3 text-center">
 @if (f.IsActive)
 {
 <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-green-100 text-green-800">Hiển thị</span>
 }
 else
 {
 <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-600">Ẩn</span>
 }
 </td>
 <td class="px-4 py-3 text-center">@f.SortOrder</td>
 <td class="px-4 py-3 text-right space-x-2">
 <a asp-action="Edit" asp-route-id="@f.Id"
 class="text-sm text-primary-600 hover:underline">Sửa</a>
 <form asp-action="Delete" asp-route-id="@f.Id" method="post" class="inline"
 onsubmit="return confirm('Xóa trường này khỏi form liên hệ?');">
 @Html.AntiForgeryToken()
 <button type="submit" class="text-sm text-red-600 hover:underline">Xóa</button>
 </form>
 </td>
 </tr>
 }

 @if (!Model.Any())
 {
 <tr>
 <td colspan="7" class="px-4 py-8 text-center text-gray-400">
 Chưa có trường nào. Bạn nên tạo tối thiểu: Họ tên, Số điện thoại, Địa chỉ, Nội dung.
 </td>
 </tr>
 }
 </tbody>
 </table>
</div>

