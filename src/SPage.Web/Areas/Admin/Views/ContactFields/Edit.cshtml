@using SPage.Domain.Entities.Contact
@model ContactField
@{
 ViewData["Title"] = Model.Id == 0 ? "Thêm trường liên hệ" : "Sửa trường liên hệ";
}

<h2 class="text-xl font-bold text-gray-800 mb-4">
 @ViewData["Title"]
</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-4 max-w-xl">
 @Html.AntiForgeryToken()

 <div>
 <label asp-for="Label" class="block mb-1 text-sm font-medium text-gray-700 ">
 Nhãn hiển thị
 </label>
 <input asp-for="Label" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>

 <div>
 <label asp-for="Name" class="block mb-1 text-sm font-medium text-gray-700 ">
 Tên (name trong form)
 </label>
 <input asp-for="Name" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 <p class="text-xs text-gray-500 mt-1">
 Chỉ chữ thường, không dấu, không khoảng trắng (vd: fullName, phone, address, message).
 </p>
 </div>

 <div>
 <label asp-for="Placeholder" class="block mb-1 text-sm font-medium text-gray-700 ">
 Placeholder
 </label>
 <input asp-for="Placeholder" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>

 <div class="grid grid-cols-2 gap-4">
 <div>
 <label asp-for="FieldType" class="block mb-1 text-sm font-medium text-gray-700 ">
 Loại trường
 </label>
 <select asp-for="FieldType" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg "
 asp-items="Html.GetEnumSelectList<ContactFieldType>()"></select>
 </div>
 <div>
 <label asp-for="SortOrder" class="block mb-1 text-sm font-medium text-gray-700 ">
 Thứ tự
 </label>
 <input asp-for="SortOrder" type="number" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 </div>

 <div class="grid grid-cols-2 gap-4">
 <div class="flex items-center gap-2 mt-2">
 <input asp-for="IsRequired" type="checkbox"
 class="w-4 h-4 text-primary-600 bg-gray-100 border-gray-300 rounded " />
 <label asp-for="IsRequired" class="text-sm text-gray-700 ">Bắt buộc nhập</label>
 </div>
 <div class="flex items-center gap-2 mt-2">
 <input asp-for="IsActive" type="checkbox"
 class="w-4 h-4 text-primary-600 bg-gray-100 border-gray-300 rounded " />
 <label asp-for="IsActive" class="text-sm text-gray-700 ">Hiển thị trên form</label>
 </div>
 </div>

 <div class="flex items-center gap-3 pt-2">
 <button type="submit" class="px-4 py-2 text-sm text-white bg-primary-600 rounded-lg hover:bg-primary-700">
 Lưu
 </button>
 <a asp-action="Index" class="text-sm text-gray-600 hover:underline ">Quay lại danh sách</a>
 </div>
</form>

@section Scripts {
 <partial name="_ValidationScriptsPartial" />
}

