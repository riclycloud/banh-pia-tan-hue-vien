@using SPage.Domain.Entities.Content
@model Slider
@{
 ViewData["Title"] = "Slide cho: " + Model.Name;
}

<div class="mb-5">
 <h1 class="text-xl font-bold text-slate-800">@ViewData["Title"]</h1>
 <p class="text-sm text-slate-500 mt-0.5">Chỉnh sửa slide và thứ tự hiển thị.</p>
</div>

<form asp-action="EditSlides" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
@Html.AntiForgeryToken()

<div class="space-y-4" id="slides-root">
@{
var slides = Model.Slides
.OrderBy(s => s.SortOrder)
.ToList();
var index = 0;
}

@foreach (var slide in slides)
{
<div class="p-4 border border-slate-200 rounded-xl bg-white " data-slide-block="existing">
<div class="flex items-center justify-between mb-2">
<span class="text-sm font-semibold text-slate-700 ">
Slide @(@index + 1)
</span>
<button type="button"
        class="text-xs text-red-600 hover:underline"
        onclick="this.closest('[data-slide-block]').remove();">
    Xóa slide
</button>
</div>

 <input type="hidden" name="slides[@index].Id" value="@slide.Id" />
 <input type="hidden" name="slides[@index].SliderId" value="@Model.Id" />

     <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
     <div>
     <label class="block mb-1 text-xs font-medium text-slate-700 ">Ảnh (URL)</label>
     <input name="slides[@index].ImageUrl" value="@slide.ImageUrl"
     class="block w-full px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl mb-2" />

     <label class="block mb-1 text-xs font-medium text-slate-700 ">Hoặc tải ảnh lên</label>
     <input type="file" name="slideImages[@index]" accept="image/*"
     class="block w-full text-sm text-slate-700 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" />

     @if (!string.IsNullOrWhiteSpace(slide.ImageUrl))
     {
     <div class="mt-2">
     <span class="block text-xs text-slate-500 mb-1">Ảnh hiện tại:</span>
     <img src="@slide.ImageUrl" alt="@slide.AltText" class="h-20 rounded border border-slate-200 object-cover" />
     </div>
     }
     </div>
 <div>
 <label class="block mb-1 text-xs font-medium text-slate-700 ">Liên kết (URL)</label>
 <input name="slides[@index].LinkUrl" value="@slide.LinkUrl"
 class="block w-full px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl " />
 </div>
 <div>
 <label class="block mb-1 text-xs font-medium text-slate-700 ">Alt text</label>
 <input name="slides[@index].AltText" value="@slide.AltText"
 class="block w-full px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl " />
 </div>
 <div>
 <label class="block mb-1 text-xs font-medium text-slate-700 ">Caption</label>
 <input name="slides[@index].Caption" value="@slide.Caption"
 class="block w-full px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl " />
 </div>
 <div>
 <label class="block mb-1 text-xs font-medium text-slate-700 ">Thứ tự</label>
 <input name="slides[@index].SortOrder" value="@slide.SortOrder" type="number"
 class="block w-full px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl " />
 </div>
 <div class="flex items-center gap-3 mt-6">
 <label class="inline-flex items-center text-sm text-slate-700 ">
 <input type="checkbox" name="slides[@index].IsActive" value="true" @(slide.IsActive ? "checked" : "")
 class="w-4 h-4 text-blue-600 border-slate-200 rounded focus:ring-blue-500" />
 <span class="ml-2">Hiển thị</span>
 </label>
 <label class="inline-flex items-center text-sm text-slate-700 ">
 <input type="checkbox" name="slides[@index].OpenInNewTab" value="true" @(slide.OpenInNewTab ? "checked" : "")
 class="w-4 h-4 text-blue-600 border-slate-200 rounded focus:ring-blue-500" />
 <span class="ml-2">Mở tab mới</span>
 </label>
 </div>
 </div>
 </div>
 index++;
 }

@for (int i = 0; i < 0; i++) { }

<div id="new-slides-container" data-next-index="@index" class="space-y-4"></div>

<div class="mt-4">
    <button type="button"
            id="add-slide-btn"
            class="px-3 py-1.5 text-xs font-medium text-blue-700 bg-blue-50 border border-blue-100 rounded-xl hover:bg-blue-100">
        + Thêm slide
    </button>
</div>
</div>

<div class="flex items-center gap-3 mt-6">
 <button type="submit" class="px-4 py-2 text-sm text-white bg-blue-600 rounded-xl hover:bg-blue-700">
 Lưu slide
 </button>
 <a asp-action="Index" class="text-sm text-slate-600 hover:text-slate-800 transition-colors">← Quay lại danh sách slider</a>
 </div>
</form>

