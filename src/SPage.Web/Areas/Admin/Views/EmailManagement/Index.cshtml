@using SPage.Domain.Entities.Email
@model List<RecipientEmail>
@{
    ViewData["Title"] = "Quản lý Email";
    var config = ViewBag.Config as EmailSendConfig;
}

<div class="flex items-center justify-between mb-5">
    <div>
        <h1 class="text-xl font-bold text-slate-800">Quản lý Email</h1>
        <p class="text-sm text-slate-500 mt-0.5">Cấu hình email gửi (SMTP) và danh sách email có thể nhận thông báo.</p>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="mb-4 px-4 py-3 rounded-xl bg-emerald-50 text-emerald-800 text-sm">@success</div>
}

@* ── Cấu hình gửi ───────────────────────────────────────────────────────── *@
<section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 mb-6">
    <h2 class="text-lg font-bold text-slate-800 mb-4">Cấu hình email gửi (SMTP)</h2>
    <form asp-action="SaveConfig" method="post" class="space-y-4 max-w-2xl">
        @Html.AntiForgeryToken()
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">SMTP Host</label>
                <input type="text" name="Host" value="@(config?.Host ?? "smtp.gmail.com")"
                       class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="smtp.gmail.com" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Cổng (Port)</label>
                <input type="number" name="Port" value="@(config?.Port ?? 587)"
                       class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Email gửi (From)</label>
                <input type="email" name="FromEmail" value="@config?.FromEmail"
                       class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="noreply@example.com" required />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Tên hiển thị (From Name)</label>
                <input type="text" name="FromName" value="@config?.FromName"
                       class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Tân Huê Viên" />
            </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Tên đăng nhập SMTP</label>
                <input type="text" name="UserName" value="@config?.UserName"
                       class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Để trống nếu không cần" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Mật khẩu SMTP</label>
                <input type="password" name="Password" value=""
                       class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Để trống nếu giữ nguyên" autocomplete="off" />
                <p class="text-xs text-slate-500 mt-1">Chỉ điền khi đổi mật khẩu</p>
            </div>
        </div>
        <div class="flex items-center gap-4 flex-wrap">
            <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="hidden" name="EnableSsl" value="false" />
                <input type="checkbox" name="EnableSsl" value="true" @(config?.EnableSsl != false ? "checked" : "") class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                <span class="text-sm text-slate-700">Bật SSL/TLS</span>
            </label>
            <label class="inline-flex items-center gap-2 cursor-pointer">
                <input type="hidden" name="IsActive" value="false" />
                <input type="checkbox" name="IsActive" value="true" @(config?.IsActive != false ? "checked" : "") class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                <span class="text-sm text-slate-700">Dùng cấu hình này khi gửi mail</span>
            </label>
        </div>
        <div>
            <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors">
                Lưu cấu hình gửi
            </button>
        </div>
    </form>
</section>

@* ── Danh sách email nhận ────────────────────────────────────────────────── *@
<section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200">
        <h2 class="text-lg font-bold text-slate-800">Danh sách email có thể nhận</h2>
        <a asp-action="CreateRecipient" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10 5a1 1 0 0 1 1 1v3h3a1 1 0 1 1 0 2h-3v3a1 1 0 1 1-2 0v-3H6a1 1 0 1 1 0-2h3V6a1 1 0 0 1 1-1Z"/></svg>
            Thêm email nhận
        </a>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
            <thead>
                <tr>
                    <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Email</th>
                    <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Tên hiển thị</th>
                    <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Nhóm</th>
                    <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-center">Trạng thái</th>
                    <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="border-b border-slate-100 hover:bg-slate-50/60 transition-colors">
                        <td class="px-4 py-3 font-medium text-slate-800">@r.Email</td>
                        <td class="px-4 py-3 text-slate-600">@(r.DisplayName ?? "—")</td>
                        <td class="px-4 py-3 text-slate-600">@(r.GroupKey ?? "—")</td>
                        <td class="px-4 py-3 text-center">
                            @if (r.IsActive)
                            {
                                <span class="bg-emerald-100 text-emerald-700 text-xs font-medium px-2.5 py-0.5 rounded-full">Bật</span>
                            }
                            else
                            {
                                <span class="bg-slate-100 text-slate-600 text-xs font-medium px-2.5 py-0.5 rounded-full">Tắt</span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <a asp-action="EditRecipient" asp-route-id="@r.Id" class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 px-2.5 py-1.5 rounded-lg transition-colors">Sửa</a>
                            <form asp-action="DeleteRecipient" asp-route-id="@r.Id" method="post" class="inline" onsubmit="return confirm('Xóa email nhận này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center gap-1 text-xs font-medium text-red-500 hover:text-red-600 hover:bg-red-50 px-2.5 py-1.5 rounded-lg transition-colors">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="px-4 py-12 text-center text-slate-400">
                            Chưa có email nhận nào. Nhấn <strong>Thêm email nhận</strong> để thêm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
