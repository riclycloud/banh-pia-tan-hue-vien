@model SPage.Areas.Admin.Controllers.DashboardStats
@{
 ViewData["Title"] = "Dashboard";
}

@* ── Page Header ─────────────────────────────────────────────────────── *@
<div class="mb-7">
 <h1 class="text-xl font-bold text-slate-800">Tổng quan</h1>
 <p class="text-sm text-slate-500 mt-0.5">Chào mừng trở lại! Đây là thống kê hệ thống.</p>
</div>

@* ── Stat Cards ───────────────────────────────────────────────────────── *@
<div class="grid grid-cols-2 gap-4 mb-5 lg:grid-cols-4">

 <a asp-area="Admin" asp-controller="Posts" asp-action="Index"
 class="block bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group overflow-hidden">
 <div class="p-5">
 <div class="flex items-center justify-between">
 <span class="text-[13px] font-medium text-slate-500">Bài viết</span>
 <div class="p-2 rounded-xl bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white transition-all duration-200">
 <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 18">
 <path d="M18 0H2a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2Zm-5.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm4.376 10.481A1 1 0 0 1 16 15H4a1 1 0 0 1-.895-1.447l3.5-7A1 1 0 0 1 7.468 6a.965.965 0 0 1 .9.5l2.775 4.757 1.546-1.887a1 1 0 0 1 1.618.1l2.541 4a1 1 0 0 1 .028 1.011Z"/>
 </svg>
 </div>
 </div>
 <p class="text-3xl font-bold text-slate-800 mt-3 tracking-tight">@Model.TotalPosts</p>
 <div class="mt-3 h-1 rounded-full bg-gradient-to-r from-blue-500 to-blue-200 opacity-70"></div>
 </div>
 </a>

 <a asp-area="Admin" asp-controller="Products" asp-action="Index"
 class="block bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group overflow-hidden">
 <div class="p-5">
 <div class="flex items-center justify-between">
 <span class="text-[13px] font-medium text-slate-500">Sản phẩm</span>
 <div class="p-2 rounded-xl bg-emerald-50 text-emerald-600 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-200">
 <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 18 20">
 <path d="M17 5.923A1 1 0 0 0 16 5h-3V4a4 4 0 1 0-8 0v1H2a1 1 0 0 0-1 .923L.086 17.846A2 2 0 0 0 2.08 20h13.84a2 2 0 0 0 1.994-2.153L17 5.923ZM7 9a1 1 0 0 1-2 0V7h2v2Zm0-5a2 2 0 1 1 4 0v1H7V4Zm6 5a1 1 0 1 1-2 0V7h2v2Z"/>
 </svg>
 </div>
 </div>
 <p class="text-3xl font-bold text-slate-800 mt-3 tracking-tight">@Model.TotalProducts</p>
 <div class="mt-3 h-1 rounded-full bg-gradient-to-r from-emerald-500 to-emerald-200 opacity-70"></div>
 </div>
 </a>

 <a asp-area="Admin" asp-controller="Pages" asp-action="Index"
 class="block bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group overflow-hidden">
 <div class="p-5">
 <div class="flex items-center justify-between">
 <span class="text-[13px] font-medium text-slate-500">Trang động</span>
 <div class="p-2 rounded-xl bg-violet-50 text-violet-600 group-hover:bg-violet-600 group-hover:text-white transition-all duration-200">
 <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
 <path d="M5 5V.13a2.96 2.96 0 0 0-1.293.749L.879 3.707A2.96 2.96 0 0 0 .13 5H5Z"/>
 <path d="M6.737 11.061a2.961 2.961 0 0 1 .81-1.515l6.117-6.116A4.839 4.839 0 0 1 16 2.141V2a1.97 1.97 0 0 0-1.933-2H7v5a2 2 0 0 1-2 2H0v11a1.969 1.969 0 0 0 1.933 2H14a2 2 0 0 0 2-2v-2.138a2.968 2.968 0 0 1-1.172.57L9.917 17.95a2.98 2.98 0 0 1-2.854-.772 2.95 2.95 0 0 1-.825-2.117Z"/>
 <path d="M19.5 6.5a2.449 2.449 0 0 0-3.46 0L10 12.54V15h2.46l6.04-6.04a2.449 2.449 0 0 0 0-3.46Z"/>
 </svg>
 </div>
 </div>
 <p class="text-3xl font-bold text-slate-800 mt-3 tracking-tight">@Model.TotalPages</p>
 <div class="mt-3 h-1 rounded-full bg-gradient-to-r from-violet-500 to-violet-200 opacity-70"></div>
 </div>
 </a>

 <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
 class="block bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 group overflow-hidden">
 <div class="p-5">
 <div class="flex items-center justify-between">
 <span class="text-[13px] font-medium text-slate-500">Chuyên mục</span>
 <div class="p-2 rounded-xl bg-amber-50 text-amber-600 group-hover:bg-amber-600 group-hover:text-white transition-all duration-200">
 <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 16 20">
 <path d="M16 14V2a2 2 0 0 0-2-2H2a2 2 0 0 0-2 2v15a3 3 0 0 0 3 3h12a1 1 0 0 0 0-2h-1v-2a2 2 0 0 0 2-2ZM4 2h2v12H4V2Zm8 16H3a1 1 0 0 1 0-2h9v2Z"/>
 </svg>
 </div>
 </div>
 <p class="text-3xl font-bold text-slate-800 mt-3 tracking-tight">@Model.TotalCategories</p>
 <div class="mt-3 h-1 rounded-full bg-gradient-to-r from-amber-500 to-amber-200 opacity-70"></div>
 </div>
 </a>
</div>

@* ── Quick Actions ─────────────────────────────────────────────────────── *@
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">Thao tác nhanh</h3>
 <div class="flex flex-wrap gap-2.5">
 <a asp-area="Admin" asp-controller="Posts" asp-action="Create"
 class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
 <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
 <path d="M10 5a1 1 0 0 1 1 1v3h3a1 1 0 1 1 0 2h-3v3a1 1 0 1 1-2 0v-3H6a1 1 0 1 1 0-2h3V6a1 1 0 0 1 1-1Z"/>
 </svg>
 Bài viết mới
 </a>
 <a asp-area="Admin" asp-controller="Categories" asp-action="Index"
 class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
 Thêm chuyên mục
 </a>
 <a asp-area="Admin" asp-controller="Seo" asp-action="Index"
 class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
 Lịch sử redirect
 </a>
 <a asp-area="Admin" asp-controller="Settings" asp-action="Index"
 class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
 Cài đặt
 </a>
 </div>
</div>
