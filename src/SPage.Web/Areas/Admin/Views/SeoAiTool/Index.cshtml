@{
    ViewData["Title"] = "Công cụ viết bài chuẩn SEO (AI)";
    var providers = ViewBag.Providers as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="flex items-center justify-between mb-5">
    <div>
        <h1 class="text-xl font-bold text-slate-800">Công cụ viết bài chuẩn SEO (AI)</h1>
        <p class="text-sm text-slate-500 mt-0.5">Nhập chủ đề hoặc nội dung gốc, AI sẽ gợi ý tiêu đề, meta description, tóm tắt và nội dung chuẩn SEO.</p>
    </div>
    <a asp-controller="AiProviders" asp-action="Index" class="text-sm text-slate-500 hover:text-blue-600">Cấu hình API Key AI →</a>
</div>

@if (TempData["Error"] is string err)
{
 <div class="mb-4 px-4 py-3 rounded-xl bg-amber-50 text-amber-800 text-sm">@err</div>
}

@Html.AntiForgeryToken()

<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    @* Input *@
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-sm font-semibold text-slate-700 mb-4">Đầu vào</h2>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Provider AI</label>
                <select id="seo-ai-provider" class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                    <option value="0">Tự chọn (provider đầu tiên)</option>
                    @foreach (var p in providers)
                    {
                        <option value="@p.Id">@(p.DisplayName ?? p.ProviderKey)</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Chủ đề / Tiêu đề bài viết <span class="text-red-500">*</span></label>
                <input type="text" id="seo-ai-topic" placeholder="VD: Cách bảo quản bánh pía tươi lâu"
                       class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Nội dung gốc (tùy chọn)</label>
                <textarea id="seo-ai-content" rows="6" placeholder="Dán nội dung có sẵn để AI tóm tắt và chuẩn hóa SEO..."
                          class="block w-full px-3 py-2.5 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500"></textarea>
            </div>
            <button type="button" id="seo-ai-generate" class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
                <span id="seo-ai-btn-text">Tạo gợi ý SEO</span>
                <span id="seo-ai-spinner" class="hidden animate-spin">⏳</span>
            </button>
            <p id="seo-ai-error" class="text-sm text-red-600 hidden"></p>
        </div>
    </div>

    @* Output *@
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h2 class="text-sm font-semibold text-slate-700 mb-4">Kết quả gợi ý</h2>
        <div id="seo-ai-result-empty" class="text-slate-400 text-sm py-8 text-center">
            Nhấn <strong>Tạo gợi ý SEO</strong> để AI sinh nội dung.
        </div>
        <div id="seo-ai-result" class="space-y-4 hidden">
            <form id="seo-ai-save-form" asp-action="SaveAsPost" asp-controller="SeoAiTool" method="post" class="mb-4 p-4 rounded-xl bg-emerald-50 border border-emerald-200">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Title" id="draft-title" />
                <input type="hidden" name="Content" id="draft-content" />
                <input type="hidden" name="Excerpt" id="draft-excerpt" />
                <input type="hidden" name="MetaTitle" id="draft-meta-title" />
                <input type="hidden" name="MetaDescription" id="draft-meta-desc" />
                <p class="text-sm text-emerald-800 mb-2">Đã có nội dung từ AI. Bạn có thể chỉnh sửa các ô bên dưới rồi lưu thành bài viết.</p>
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-emerald-600 rounded-xl hover:bg-emerald-700 transition-colors">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M7.707 10.293a1 1 0 0 0-1.414 1.414l3 3a1 1 0 0 0 1.414 0l3-3a1 1 0 0 0-1.414-1.414L11 11.586V6h5a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5v5.586l-1.293-1.293z"/></svg>
                    Lưu thành bài viết
                </button>
            </form>
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Tiêu đề</label>
                <div class="flex gap-2">
                    <input type="text" id="out-title" class="flex-1 px-3 py-2 text-sm border border-slate-200 rounded-xl bg-slate-50" />
                    <button type="button" class="copy-btn px-3 py-2 text-xs font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200" data-target="out-title">Copy</button>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Meta Title</label>
                <div class="flex gap-2">
                    <input type="text" id="out-meta-title" readonly class="flex-1 px-3 py-2 text-sm border border-slate-200 rounded-xl bg-slate-50" />
                    <button type="button" class="copy-btn px-3 py-2 text-xs font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200" data-target="out-meta-title">Copy</button>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Meta Description</label>
                <div class="flex gap-2">
                    <textarea id="out-meta-desc" rows="2" class="flex-1 px-3 py-2 text-sm border border-slate-200 rounded-xl bg-slate-50"></textarea>
                    <button type="button" class="copy-btn px-3 py-2 text-xs font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 self-start" data-target="out-meta-desc">Copy</button>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Tóm tắt (Excerpt)</label>
                <div class="flex gap-2">
                    <textarea id="out-excerpt" rows="2" class="flex-1 px-3 py-2 text-sm border border-slate-200 rounded-xl bg-slate-50"></textarea>
                    <button type="button" class="copy-btn px-3 py-2 text-xs font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 self-start" data-target="out-excerpt">Copy</button>
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Gợi ý nội dung</label>
                <textarea id="out-content" rows="6" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl bg-slate-50"></textarea>
                <button type="button" class="copy-btn mt-2 px-3 py-2 text-xs font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200" data-target="out-content">Copy</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function() {
    var btn = document.getElementById('seo-ai-generate');
    var btnText = document.getElementById('seo-ai-btn-text');
    var spinner = document.getElementById('seo-ai-spinner');
    var errEl = document.getElementById('seo-ai-error');
    var emptyEl = document.getElementById('seo-ai-result-empty');
    var resultEl = document.getElementById('seo-ai-result');
    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    btn.addEventListener('click', function() {
        var topic = document.getElementById('seo-ai-topic').value.trim();
        if (!topic) {
            errEl.textContent = 'Vui lòng nhập chủ đề hoặc tiêu đề.';
            errEl.classList.remove('hidden');
            return;
        }
        errEl.classList.add('hidden');
        btn.disabled = true;
        btnText.textContent = 'Đang xử lý...';
        spinner.classList.remove('hidden');

        var payload = {
            providerId: parseInt(document.getElementById('seo-ai-provider').value, 10) || 0,
            topicOrTitle: topic,
            existingContent: document.getElementById('seo-ai-content').value.trim() || null,
            language: 'vi'
        };

        fetch('@Url.Action("GenerateSeoContent", "SeoAiTool", new { area = "Admin" })', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'RequestVerificationToken': token || ''
            },
            body: JSON.stringify(payload)
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                document.getElementById('out-title').value = data.title || '';
                document.getElementById('out-meta-title').value = data.metaTitle || '';
                document.getElementById('out-meta-desc').value = data.metaDescription || '';
                document.getElementById('out-excerpt').value = data.excerpt || '';
                document.getElementById('out-content').value = data.contentSuggestion || '';
                syncDraftFromOutputs();
                emptyEl.classList.add('hidden');
                resultEl.classList.remove('hidden');
            } else {
                errEl.textContent = data.error || 'Có lỗi xảy ra.';
                errEl.classList.remove('hidden');
            }
        })
        .catch(function(e) {
            errEl.textContent = e.message || 'Lỗi kết nối.';
            errEl.classList.remove('hidden');
        })
        .finally(function() {
            btn.disabled = false;
            btnText.textContent = 'Tạo gợi ý SEO';
            spinner.classList.add('hidden');
        });
    });

    document.querySelectorAll('.copy-btn').forEach(function(b) {
        b.addEventListener('click', function() {
            var id = this.getAttribute('data-target');
            var el = document.getElementById(id);
            if (el) {
                el.select();
                document.execCommand('copy');
                var t = b.textContent;
                b.textContent = 'Đã copy!';
                setTimeout(function() { b.textContent = t; }, 1500);
            }
        });
    });

    function syncDraftFromOutputs() {
        document.getElementById('draft-title').value = document.getElementById('out-title').value;
        document.getElementById('draft-content').value = document.getElementById('out-content').value;
        document.getElementById('draft-excerpt').value = document.getElementById('out-excerpt').value;
        document.getElementById('draft-meta-title').value = document.getElementById('out-meta-title').value;
        document.getElementById('draft-meta-desc').value = document.getElementById('out-meta-desc').value;
    }

    var saveForm = document.getElementById('seo-ai-save-form');
    if (saveForm) saveForm.addEventListener('submit', function() {
        syncDraftFromOutputs();
    });
})();
</script>
}
