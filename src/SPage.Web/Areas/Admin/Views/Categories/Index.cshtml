@using SPage.Application.Features.Categories.DTOs
@model List<CategoryDto>
@{
 ViewData["Title"] = "Chuyên mục";
}

@* ── Page Header ──────────────────────────────────────────────────────────── *@
<div class="flex items-center justify-between mb-5">
 <div>
 <h1 class="text-xl font-bold text-slate-800">Chuyên mục</h1>
 <p class="text-sm text-slate-500 mt-0.5">@Model.Count chuyên mục trong hệ thống</p>
 </div>
</div>

<div class="grid grid-cols-1 gap-5 lg:grid-cols-5">

 @* ── Add Form ── *@
 <div class="lg:col-span-2">
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">Thêm chuyên mục</h3>
 <form asp-action="Create" method="post">
 @Html.AntiForgeryToken()
 <div class="space-y-3">
 <div>
 <label class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Tên chuyên mục <span class="text-red-500">*</span>
 </label>
 <input type="text" name="name" required placeholder="VD: Công nghệ"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 <div>
 <label class="block mb-1.5 text-[13px] font-medium text-slate-600">Mô tả</label>
 <textarea name="description" rows="2" placeholder="Mô tả ngắn về chuyên mục..."
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"></textarea>
 </div>
 <div>
 <label class="block mb-1.5 text-[13px] font-medium text-slate-600">Chuyên mục cha</label>
 <select name="parentId"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
 <option value="">-- Không có --</option>
 @foreach (var cat in Model.Where(c => c.ParentId == null))
 {
 <option value="@cat.Id">@cat.Name</option>
 }
 </select>
 </div>
 <button type="submit"
 class="w-full px-4 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
 Thêm chuyên mục
 </button>
 </div>
 </form>
 </div>
 </div>

 @* ── List ── *@
 <div class="lg:col-span-3">
 <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm">
 <table class="w-full text-sm text-left">
 <thead>
 <tr>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Tên</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 hidden sm:table-cell">Slug</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 hidden md:table-cell">Cha</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-center">Bài viết</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-right">Thao tác</th>
 </tr>
 </thead>
 <tbody class="bg-white">
 @foreach (var cat in Model)
 {
 <tr class="border-b border-slate-100 hover:bg-slate-50/60 transition-colors">
 <td class="px-4 py-3 font-medium text-slate-800">
 @if (cat.ParentId.HasValue)
 {
 <span class="mr-1 text-slate-300">└</span>
 }
 @cat.Name
 </td>
 <td class="px-4 py-3 text-slate-500 font-mono text-xs hidden sm:table-cell">
 <div class="flex items-center gap-1.5">
 <span>@cat.Slug</span>
 <a href="/@cat.Slug" target="_blank" class="text-slate-400 hover:text-blue-600 transition-colors" title="Xem trên web">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
 </svg>
 </a>
 </div>
 </td>
 <td class="px-4 py-3 text-slate-500 hidden md:table-cell">@(cat.ParentName ?? "—")</td>
 <td class="px-4 py-3 text-center">
 <span class="inline-flex items-center justify-center w-7 h-7 text-xs font-semibold rounded-full
 @(cat.PostCount > 0 ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-500")">
 @cat.PostCount
 </span>
 </td>
 <td class="px-4 py-3 text-right space-x-1">
 <a asp-action="Edit" asp-route-id="@cat.Id"
 class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 px-2.5 py-1.5 rounded-lg transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232 18.768 8.768M4 20h4l10-10-4-4L4 16v4z"/>
 </svg>
 Sửa
 </a>
 <form class="inline js-delete-form" data-confirm="Bạn có chắc muốn xóa chuyên mục «@cat.Name»?" data-url="@Url.Action("Delete", "Categories", new { area = "Admin", id = cat.Id })">
 @Html.AntiForgeryToken()
 <button type="button" class="js-delete-btn inline-flex items-center gap-1 text-xs font-medium text-red-500 hover:text-red-600 hover:bg-red-50 px-2.5 py-1.5 rounded-lg transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
 @(cat.PostCount > 0 ? "disabled title=\"Có bài viết đang dùng\"" : "")>
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16"/>
 </svg>
 Xóa
 </button>
 </form>
 </td>
 </tr>
 }

 @if (!Model.Any())
 {
 <tr>
 <td colspan="5" class="px-4 py-12 text-center">
 <div class="flex flex-col items-center gap-2 text-slate-400">
 <svg class="w-8 h-8 opacity-40" fill="currentColor" viewBox="0 0 16 20">
 <path d="M16 14V2a2 2 0 0 0-2-2H2a2 2 0 0 0-2 2v15a3 3 0 0 0 3 3h12a1 1 0 0 0 0-2h-1v-2a2 2 0 0 0 2-2ZM4 2h2v12H4V2Zm8 16H3a1 1 0 0 1 0-2h9v2Z"/>
 </svg>
 <p class="text-sm">Chưa có chuyên mục nào.</p>
 </div>
 </td>
 </tr>
 }
 </tbody>
 </table>
 </div>
 </div>
</div>

@section Scripts {
<script>
(function() {
 document.querySelectorAll('.js-delete-form').forEach(function(form) {
 var btn = form.querySelector('.js-delete-btn');
 if (!btn) return;
 btn.addEventListener('click', function() {
 if (btn.disabled) return;
 var url = form.dataset.url, msg = form.dataset.confirm;
 if (!msg || !confirm(msg)) return;
 var token = form.querySelector('input[name="__RequestVerificationToken"]');
 var body = token ? '__RequestVerificationToken=' + encodeURIComponent(token.value) : '';
 fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' }, body: body })
 .then(function(r) { return r.json(); })
 .then(function(d) { if (typeof showToast === 'function') showToast(d.message, !d.success); if (d.success) location.reload(); })
 .catch(function() { if (typeof showToast === 'function') showToast('Xóa thất bại.', true); });
 });
 });
})();
</script>
}
