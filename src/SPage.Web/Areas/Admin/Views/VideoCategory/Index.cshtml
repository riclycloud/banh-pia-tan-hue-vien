@using SPage.Application.Features.VideoLibrary.DTOs
@model List<VideoCategoryDto>
@{
    ViewData["Title"] = "Danh mục Video";
}

<div class="p-6 max-w-3xl mx-auto">

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-slate-800">Danh mục Video</h1>
      <p class="text-sm text-slate-500 mt-0.5">@Model.Count danh mục</p>
    </div>
    <a asp-area="Admin" asp-controller="VideoLibrary" asp-action="Index"
       class="text-sm text-blue-600 hover:underline">← Thư viện video</a>
  </div>

  @if (TempData["Success"] is string s)
  {
    <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl">@s</div>
  }
  @if (TempData["Error"] is string e)
  {
    <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl">@e</div>
  }

  @* List *@
  <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden mb-6">
    @if (!Model.Any())
    {
      <p class="text-center py-12 text-slate-400 text-sm">Chưa có danh mục nào.</p>
    }
    else
    {
      <table class="w-full text-sm">
        <thead class="bg-slate-50 border-b border-slate-100">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Tên</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Slug</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wide">Thứ tự</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wide">Video</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-slate-500 uppercase tracking-wide">Hiển thị</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wide">Thao tác</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50" id="cat-list">
          @foreach (var c in Model)
          {
            <tr data-id="@c.Id" class="hover:bg-slate-50">
              <td class="px-4 py-3 font-medium text-slate-800">@c.Name</td>
              <td class="px-4 py-3 font-mono text-xs text-slate-500">@c.Slug</td>
              <td class="px-4 py-3 text-center text-slate-500">@c.DisplayOrder</td>
              <td class="px-4 py-3 text-center text-slate-500">@c.VideoCount</td>
              <td class="px-4 py-3 text-center">
                @if (c.IsActive)
                {<span class="inline-block w-2 h-2 rounded-full bg-green-400"></span>}
                else
                {<span class="inline-block w-2 h-2 rounded-full bg-slate-300"></span>}
              </td>
              <td class="px-4 py-3 text-right">
                <div class="flex items-center justify-end gap-3">
                  <button type="button"
                          onclick="openEdit(@c.Id, '@Html.Raw(c.Name.Replace("'","\\\'"))', '@Html.Raw((c.Description ?? "").Replace("'","\\\'"))', @c.DisplayOrder, @(c.IsActive ? "true" : "false"))"
                          class="text-blue-600 hover:text-blue-800 text-xs font-medium">Sửa</button>
                  <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                        onsubmit="return confirm('Xóa danh mục này? Các video trong danh mục vẫn giữ nguyên.')">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="text-red-500 hover:text-red-700 text-xs font-medium">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    }
  </div>

  @* Add form *@
  <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
    <h3 class="text-sm font-semibold text-slate-700 mb-4">Thêm danh mục mới</h3>
    <form asp-action="Create" method="post" class="space-y-3">
      @Html.AntiForgeryToken()
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Tên danh mục <span class="text-red-400">*</span></label>
          <input name="name" required placeholder="Tin tức, TVC, Giải trí..."
                 class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Thứ tự hiển thị</label>
          <input name="displayOrder" type="number" value="0"
                 class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1">Mô tả</label>
        <input name="description" placeholder="Mô tả ngắn (không bắt buộc)"
               class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
      </div>
      <div class="flex items-center gap-2">
        <input name="isActive" type="checkbox" checked value="true" id="chk-active"
               class="w-4 h-4 rounded border-slate-300 text-blue-600"/>
        <label for="chk-active" class="text-sm text-slate-600 cursor-pointer">Hiển thị công khai</label>
      </div>
      <button type="submit"
              class="px-5 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl transition-colors">
        + Thêm danh mục
      </button>
    </form>
  </div>
</div>

@* Edit modal *@
<div id="edit-modal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-center justify-center">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6">
    <h3 class="text-sm font-semibold text-slate-700 mb-4">Sửa danh mục</h3>
    <form id="edit-form" method="post" class="space-y-3">
      @Html.AntiForgeryToken()
      <input type="hidden" id="edit-id" name="id"/>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Tên <span class="text-red-400">*</span></label>
          <input id="edit-name" name="name" required
                 class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Thứ tự</label>
          <input id="edit-order" name="displayOrder" type="number"
                 class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
        </div>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-500 mb-1">Mô tả</label>
        <input id="edit-desc" name="description"
               class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500"/>
      </div>
      <label class="flex items-center gap-2 cursor-pointer">
        <input id="edit-active" name="isActive" type="checkbox" value="true"
               class="w-4 h-4 rounded border-slate-300 text-blue-600"/>
        <span class="text-sm text-slate-600">Hiển thị công khai</span>
      </label>
      <div class="flex gap-2 pt-2">
        <button type="submit" class="flex-1 py-2.5 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium rounded-xl">Lưu</button>
        <button type="button" onclick="document.getElementById('edit-modal').classList.add('hidden')"
                class="px-4 py-2.5 border border-slate-200 text-slate-600 text-sm rounded-xl">Hủy</button>
      </div>
    </form>
  </div>
</div>

@section Scripts {
<script>
function openEdit(id, name, desc, order, active) {
    document.getElementById('edit-id').value    = id;
    document.getElementById('edit-name').value  = name;
    document.getElementById('edit-desc').value  = desc;
    document.getElementById('edit-order').value = order;
    document.getElementById('edit-active').checked = active;
    document.getElementById('edit-form').action = '/admin/video-category/edit/' + id;
    document.getElementById('edit-modal').classList.remove('hidden');
}
document.getElementById('edit-modal').addEventListener('click', function(e) {
    if (e.target === this) this.classList.add('hidden');
});
</script>
}
