@model SPage.Areas.Admin.Controllers.PageFormModel
@using SPage.Domain.Enums
@{
    ViewData["Title"] = "Sửa trang";
}

@* ── Editor CSS (CodeMirror + Quill) — loaded in body, applied before scripts ── *@
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.css">
<link rel="stylesheet" href="https://cdn.quilljs.com/1.3.7/quill.snow.css">
<style>
    /* CodeMirror tweaks */
    .CodeMirror { height: 240px; font-size: 12.5px; border: 1px solid #e2e8f0; border-radius: 0.5rem; }
    .CodeMirror-scroll { padding: 4px 0; }

    /* Quill tweaks */
    .ql-container.ql-snow { border-radius: 0 0 0.5rem 0.5rem; font-size: 14px; min-height: 150px; }
    .ql-toolbar.ql-snow  { border-radius: 0.5rem 0.5rem 0 0; border-color: #e2e8f0; background: #f8fafc; }
    .ql-container.ql-snow { border-color: #e2e8f0; }
    .ql-editor { min-height: 150px; }

    /* Section type badge colors */
    .sec-badge-code  { background: #1e293b; color: #7dd3fc; }
    .sec-badge-rich  { background: #14532d; color: #86efac; }
    .sec-badge-block { background: #1e3a5f; color: #93c5fd; }

    /* Style panel alignment buttons */
    .align-btn         { padding: 2px 8px; font-size: 11px; border: 1px solid #e2e8f0; border-radius: 6px; background: white; cursor: pointer; color: #64748b; transition: all .15s; }
    .align-btn.active  { background: #3b82f6; color: white; border-color: #3b82f6; }
    .align-btn:hover:not(.active) { background: #f1f5f9; }

    /* Upload button */
    .btn-upload { padding: 3px 8px; font-size: 11px; border: 1px solid #bfdbfe; border-radius: 6px; background: white; color: #2563eb; cursor: pointer; white-space: nowrap; transition: background .15s; }
    .btn-upload:hover { background: #eff6ff; }
    .btn-browse { padding: 3px 8px; font-size: 11px; border: 1px solid #c4b5fd; border-radius: 6px; background: white; color: #7c3aed; cursor: pointer; white-space: nowrap; transition: background .15s; }
    .btn-browse:hover { background: #f5f3ff; }
    /* Image picker modal */
    #img-picker-modal { display:none; position:fixed; inset:0; z-index:999; background:rgba(0,0,0,.5); align-items:center; justify-content:center; }
    #img-picker-modal.open { display:flex; }
    #img-picker-inner { background:#fff; border-radius:1rem; width:min(880px,96vw); max-height:85vh; display:flex; flex-direction:column; overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,.3); }
    #img-picker-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(120px,1fr)); gap:10px; overflow-y:auto; padding:12px; flex:1; }
    .picker-item { position:relative; cursor:pointer; border-radius:8px; overflow:hidden; aspect-ratio:1/1; border:2px solid transparent; transition:border-color .15s,transform .15s; }
    .picker-item:hover { border-color:#3b82f6; transform:scale(1.03); }
    .picker-item img { width:100%; height:100%; object-fit:cover; display:block; }
    .picker-item .picker-name { position:absolute; bottom:0; left:0; right:0; background:rgba(0,0,0,.6); color:#fff; font-size:9px; padding:2px 4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
</style>

@* ── Breadcrumb + nút về danh sách (trong Admin) ── *@
<div class="flex flex-wrap items-center justify-between gap-3 mb-5">
    <div class="flex items-center gap-2 text-sm">
        <a asp-area="Admin" asp-controller="Pages" asp-action="Index" class="text-slate-400 hover:text-blue-600 transition-colors">Trang động</a>
        <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
        </svg>
        <span class="text-slate-600 font-medium">@Model.Title</span>
    </div>
    <a asp-area="Admin" asp-controller="Pages" asp-action="Index" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        Về danh sách trang
    </a>
</div>

@if (TempData["Success"] is string msg)
{
    <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl">@msg</div>
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="page-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">

        @* ── Main column ── *@
        <div class="lg:col-span-2 space-y-4">

            @* Title + Slug *@
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
                <div>
                    <label asp-for="Title" class="block mb-1.5 text-[13px] font-medium text-slate-600">
                        Tiêu đề <span class="text-red-500">*</span>
                    </label>
                    <input asp-for="Title" id="page-title" placeholder="Nhập tiêu đề trang..."
                           class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                    <span asp-validation-for="Title" class="text-xs text-red-500 mt-1 block"></span>
                </div>
                <div>
                    <label asp-for="Slug" class="block mb-1.5 text-[13px] font-medium text-slate-600">Slug (URL)</label>
                    <div class="flex rounded-xl overflow-hidden border border-slate-200 focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500 transition-colors">
                        <span class="px-3 py-2.5 text-xs text-slate-500 bg-slate-50 border-r border-slate-200 shrink-0 flex items-center">/</span>
                        <input asp-for="Slug" id="page-slug" autocomplete="off"
                               class="flex-1 px-3 py-2.5 text-sm bg-white text-slate-900 focus:outline-none font-mono" />
                    </div>
                    <span asp-validation-for="Slug" class="text-xs text-red-500 mt-1 block"></span>
                    <p class="mt-1 text-xs text-amber-500">⚠ Thay đổi slug sẽ làm mất URL cũ.</p>
                </div>
            </div>

            @* ── Section Builder ── *@
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                <div class="flex items-center justify-between mb-1">
                    <h3 class="text-sm font-semibold text-slate-700">Page Sections</h3>
                    <div class="flex items-center gap-2">
                        @* ── Library picker ── *@
                        <div class="relative" id="lib-menu-wrap">
                            <button type="button" id="btn-lib"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-600 bg-slate-100 border border-slate-200 rounded-lg hover:bg-slate-200 transition-colors"
                                    title="Chèn từ thư viện">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
                                </svg>
                                Thư viện
                            </button>
                            <div id="lib-dropdown"
                                 class="hidden absolute right-0 top-full mt-1 w-64 bg-white border border-slate-200 rounded-xl shadow-lg z-20 py-1.5 text-sm max-h-72 overflow-y-auto">
                                <p class="px-3 pt-1 pb-1 text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Thư viện section</p>
                                <div id="lib-items-list">
                                    <p class="px-3 py-2 text-xs text-slate-400">Đang tải...</p>
                                </div>
                                <div class="border-t border-slate-100 mt-1 pt-1">
                                    <a href="/admin/component-library" target="_blank"
                                       class="flex items-center gap-2 px-3 py-1.5 text-xs text-blue-600 hover:bg-blue-50">
                                        ✏️ Quản lý thư viện
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="relative" id="add-section-menu-wrap">
                            <button type="button" id="btn-add-section"
                                    class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-lg hover:bg-blue-100 transition-colors">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                </svg>
                                Thêm section
                                <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                                </svg>
                            </button>
                            @* Type picker dropdown *@
                            <div id="add-section-dropdown"
                                 class="hidden absolute right-0 top-full mt-1 w-52 bg-white border border-slate-200 rounded-xl shadow-lg z-20 py-1.5 text-sm">
                                <p class="px-3 pt-1 pb-1.5 text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Nội dung</p>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="TextBlock">
                                    <span class="w-2 h-2 rounded-full bg-green-400 shrink-0"></span>TextBlock <span class="ml-auto text-[10px] text-slate-400">rich text</span>
                                </button>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="RichText">
                                    <span class="w-2 h-2 rounded-full bg-green-400 shrink-0"></span>RichText <span class="ml-auto text-[10px] text-slate-400">editor</span>
                                </button>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="RawHtml">
                                    <span class="w-2 h-2 rounded-full bg-sky-400 shrink-0"></span>RawHtml <span class="ml-auto text-[10px] text-slate-400">HTML code</span>
                                </button>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="CssBlock">
                                    <span class="w-2 h-2 rounded-full bg-sky-400 shrink-0"></span>CssBlock <span class="ml-auto text-[10px] text-slate-400">CSS code</span>
                                </button>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="JsBlock">
                                    <span class="w-2 h-2 rounded-full bg-sky-400 shrink-0"></span>JsBlock <span class="ml-auto text-[10px] text-slate-400">JS code</span>
                                </button>
                                <hr class="my-1 border-slate-100">
                                <p class="px-3 pt-1 pb-1.5 text-[10px] font-semibold text-slate-400 uppercase tracking-wider">Components</p>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="Hero">
                                    <span class="w-2 h-2 rounded-full bg-violet-400 shrink-0"></span>Hero
                                </button>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="Gallery">
                                    <span class="w-2 h-2 rounded-full bg-violet-400 shrink-0"></span>Gallery
                                </button>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="ContactForm">
                                    <span class="w-2 h-2 rounded-full bg-violet-400 shrink-0"></span>ContactForm
                                </button>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="ProductList">
                                    <span class="w-2 h-2 rounded-full bg-violet-400 shrink-0"></span>ProductList
                                </button>
                                <button type="button" class="pick-type w-full text-left px-3 py-1.5 hover:bg-slate-50 flex items-center gap-2.5" data-type="Testimonials">
                                    <span class="w-2 h-2 rounded-full bg-violet-400 shrink-0"></span>Testimonials
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="text-xs text-slate-400 mb-4">Kéo ↑↓ để sắp xếp. Lưu trang để lưu sections.</p>

                <input type="hidden" asp-for="SectionsJson" id="SectionsJson" />

                <p id="sections-empty" class="text-center py-10 text-slate-400 text-sm">
                    Chưa có section nào. Nhấn <strong>Thêm section</strong> để bắt đầu.
                </p>
                <div id="sections-container" class="space-y-3"></div>
            </div>

            @* SEO *@
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                <h3 class="text-sm font-semibold text-slate-700 mb-4">SEO</h3>
                <div class="space-y-4">
                    <div>
                        <label asp-for="MetaTitle" class="block mb-1.5 text-[13px] font-medium text-slate-600">
                            Meta Title <span class="text-slate-400 font-normal">(tối đa 70 ký tự)</span>
                        </label>
                        <input asp-for="MetaTitle" id="meta-title" maxlength="70"
                               class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                        <div class="flex justify-between mt-1">
                            <span asp-validation-for="MetaTitle" class="text-xs text-red-500"></span>
                            <span id="meta-title-count" class="text-xs text-slate-400">0/70</span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="MetaDescription" class="block mb-1.5 text-[13px] font-medium text-slate-600">
                            Meta Description <span class="text-slate-400 font-normal">(tối đa 160 ký tự)</span>
                        </label>
                        <textarea asp-for="MetaDescription" id="meta-desc" rows="2" maxlength="160"
                                  class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"></textarea>
                        <div class="flex justify-between mt-1">
                            <span asp-validation-for="MetaDescription" class="text-xs text-red-500"></span>
                            <span id="meta-desc-count" class="text-xs text-slate-400">0/160</span>
                        </div>
                    </div>
                    <div>
                        <label asp-for="CanonicalUrl" class="block mb-1.5 text-[13px] font-medium text-slate-600">Canonical URL</label>
                        <input asp-for="CanonicalUrl" placeholder="https://..."
                               class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
                    </div>
                    <div class="flex items-center gap-2.5 pt-1">
                        <input asp-for="IsIndexable" type="checkbox" id="is-indexable"
                               class="w-4 h-4 text-blue-600 bg-white border-slate-300 rounded accent-blue-600" />
                        <label asp-for="IsIndexable" class="text-[13px] text-slate-600 cursor-pointer">
                            Cho phép Google index trang này
                        </label>
                    </div>
                </div>
            </div>
        </div>

        @* ── Sidebar ── *@
        <div class="space-y-4">

            @* Publish *@
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                <h3 class="text-sm font-semibold text-slate-700 mb-4">Xuất bản</h3>
                <div class="space-y-3 mb-4">
                    <div>
                        <label asp-for="Status" class="block mb-1.5 text-[13px] font-medium text-slate-600">Trạng thái</label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<PageStatus>()"
                                class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                        </select>
                    </div>
                    <div>
                        <label asp-for="Template" class="block mb-1.5 text-[13px] font-medium text-slate-600">Template</label>
                        <select asp-for="Template"
                                class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                            <option value="Default">Default</option>
                            <option value="LandingPage">LandingPage</option>
                            <option value="Contact">Contact</option>
                            <option value="About">About</option>
                            <option value="FullWidth">FullWidth</option>
                        </select>
                    </div>
                </div>
                <div class="flex gap-2 pt-3 border-t border-slate-100">
                    <button type="submit"
                            class="flex-1 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
                        Lưu thay đổi
                    </button>
                    <a asp-area="Admin" asp-controller="Pages" asp-action="Index"
                       class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
                        Hủy
                    </a>
                </div>
            </div>

            @* Section summary *@
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4">
                <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-2">Sections</h4>
                <p id="sections-count" class="text-sm text-slate-700 font-medium">0 sections</p>
                <div id="sections-type-list" class="mt-2 space-y-1 text-xs text-slate-500"></div>
            </div>

            @* Preview link *@
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4">
                <h4 class="text-xs font-semibold text-slate-500 uppercase tracking-wide mb-3">Xem trước</h4>
                <a href="/@Model.Slug" target="_blank"
                   class="inline-flex items-center gap-2 text-sm text-blue-600 hover:underline font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    /@Model.Slug
                </a>
            </div>

            @* Danger zone *@
            <div class="bg-red-50 border border-red-100 rounded-2xl p-4">
                <h4 class="text-xs font-semibold text-red-600 uppercase tracking-wide mb-3">Vùng nguy hiểm</h4>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                      onsubmit="return confirm('Xóa trang này? Hành động không thể hoàn tác.');">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="w-full px-4 py-2 text-sm font-medium text-red-600 border border-red-200 bg-white rounded-xl hover:bg-red-50 transition-colors">
                        Xóa trang này
                    </button>
                </form>
            </div>
        </div>
    </div>
</form>

@section Scripts {
@* ── CodeMirror 5 ── *@
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.17/mode/htmlmixed/htmlmixed.min.js"></script>
@* ── Quill 1.3.7 ── *@
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
@* Dữ liệu sections từ server (tránh value attribute bị cắt/lỗi khi JSON dài) *@
<script>
    window.__pageSectionsFromServer = @Html.Raw(Model.SectionsJson ?? "[]");
</script>
<script>
(function () {
    'use strict';

    // ── Meta counters ────────────────────────────────────────────────────────
    function counter(inputId, counterId, max) {
        var el = document.getElementById(inputId), cnt = document.getElementById(counterId);
        if (!el || !cnt) return;
        function upd() { var l = el.value.length; cnt.textContent = l + '/' + max; cnt.className = 'text-xs ' + (l > max * 0.9 ? 'text-orange-500' : 'text-slate-400'); }
        el.addEventListener('input', upd); upd();
    }
    counter('meta-title', 'meta-title-count', 70);
    counter('meta-desc', 'meta-desc-count', 160);

    // ── Section Builder ──────────────────────────────────────────────────────

    function isCodeType(t)  { return t === 'RawHtml' || t === 'CssBlock' || t === 'JsBlock'; }
    function isRichType(t)  { return t === 'TextBlock' || t === 'RichText'; }

    function codeMode(t) {
        if (t === 'CssBlock')  return 'css';
        if (t === 'JsBlock')   return 'javascript';
        return 'htmlmixed';
    }
    function codeKey(t) {
        if (t === 'CssBlock')  return 'css';
        if (t === 'JsBlock')   return 'js';
        return 'html';
    }
    function typeColor(t) {
        if (isCodeType(t))  return '#0ea5e9';
        if (isRichType(t))  return '#22c55e';
        return '#a78bfa';
    }
    function typeLabel(t) {
        var map = { TextBlock: 'Rich Text', RichText: 'Rich Text', RawHtml: 'HTML', CssBlock: 'CSS', JsBlock: 'JS',
                    Hero: 'Hero', Gallery: 'Gallery', ContactForm: 'Form', ProductList: 'Products', Testimonials: 'Testimonials' };
        return map[t] || t;
    }

    // ── Static component field definitions ────────────────────────────────────
    var COMPONENT_FIELDS = {
        Hero: [
            { key: 'heading',    label: 'Tiêu đề chính', type: 'text',     span: 2, placeholder: 'Nhập tiêu đề hero...' },
            { key: 'subheading', label: 'Mô tả phụ',      type: 'textarea', span: 2, placeholder: 'Nhập mô tả ngắn...' },
            { key: 'buttonText', label: 'Nhãn nút CTA',   type: 'text',     span: 1, placeholder: 'Xem thêm' },
