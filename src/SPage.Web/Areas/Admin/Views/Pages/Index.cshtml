@model IEnumerable<SPage.Domain.Entities.Page.DynamicPage>
@using SPage.Domain.Enums
@{
    ViewData["Title"] = "Trang động";
}

<div class="flex items-center justify-between mb-5">
    <div>
        <h1 class="text-xl font-bold text-slate-800">Trang động</h1>
        <p class="text-sm text-slate-500 mt-0.5">Quản lý trang nội dung tùy chỉnh (Page Builder)</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Thêm trang
    </a>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    @if (!Model.Any())
    {
        <div class="px-6 py-16 text-center">
            <svg class="w-12 h-12 mx-auto text-slate-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5.586a1 1 0 0 1 .707.293l5.414 5.414a1 1 0 0 1 .293.707V19a2 2 0 0 1-2 2z" />
            </svg>
            <p class="text-slate-400 text-sm">Chưa có trang nào. Nhấn <strong>Thêm trang</strong> để bắt đầu.</p>
        </div>
    }
    else
    {
        <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Tiêu đề</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide hidden sm:table-cell">Slug</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide hidden md:table-cell">Template</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Trạng thái</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide hidden lg:table-cell">Ngày tạo</th>
                    <th class="px-5 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @{
                    var homePageId = ViewBag.HomePageId as int?;
                }
                @foreach (var pg in Model)
                {
                    var isHomePage = homePageId == pg.Id;
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-5 py-3 font-medium text-slate-800">
                            @pg.Title
                            @if (isHomePage)
                            {
                                <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-blue-100 text-blue-700" title="Đang dùng làm trang chủ">Trang chủ</span>
                            }
                        </td>
                        <td class="px-5 py-3 font-mono text-xs text-slate-500 hidden sm:table-cell">/@pg.Slug</td>
                        <td class="px-5 py-3 text-slate-600 hidden md:table-cell">
                            <span class="px-2 py-0.5 bg-slate-100 rounded text-xs font-mono">@pg.Template</span>
                        </td>
                        <td class="px-5 py-3">
                            @{
                                var (bg, fg) = pg.Status switch
                                {
                                    PageStatus.Published => ("bg-green-100", "text-green-700"),
                                    PageStatus.Archived  => ("bg-slate-100", "text-slate-500"),
                                    _                    => ("bg-yellow-100", "text-yellow-700"),
                                };
                                var label = pg.Status switch
                                {
                                    PageStatus.Published => "Đã xuất bản",
                                    PageStatus.Archived  => "Lưu trữ",
                                    _                    => "Nháp",
                                };
                            }
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium @bg @fg">@label</span>
                        </td>
                        <td class="px-5 py-3 text-slate-500 text-xs hidden lg:table-cell">
                            @pg.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                        </td>
                        <td class="px-5 py-3 text-right">
                            <div class="flex items-center justify-end gap-3 flex-wrap">
                                @if (pg.Status == PageStatus.Published)
                                {
                                    @if (isHomePage)
                                    {
                                        <form asp-action="SetAsHomepage" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="" />
                                            <button type="submit" class="text-xs text-amber-600 hover:underline font-medium">Bỏ làm trang chủ</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="SetAsHomepage" asp-route-id="@pg.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-xs text-blue-600 hover:underline font-medium">Đặt làm trang chủ</button>
                                        </form>
                                    }
                                }
                                <a href="/@pg.Slug" target="_blank"
                                   class="text-xs text-slate-400 hover:text-slate-700 transition-colors" title="Xem trang">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                              d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </a>
                                <a asp-action="Edit" asp-route-id="@pg.Id"
                                   class="text-xs text-blue-600 hover:underline font-medium">Sửa</a>
                                <form class="inline js-delete-form" data-confirm="Bạn có chắc muốn xóa trang «@pg.Title»?" data-url="@Url.Action("Delete", "Pages", new { area = "Admin", id = pg.Id })">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="js-delete-btn text-xs text-red-500 hover:underline font-medium">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
<script>
(function() {
 document.querySelectorAll('.js-delete-form').forEach(function(form) {
 var btn = form.querySelector('.js-delete-btn');
 if (!btn) return;
 btn.addEventListener('click', function() {
 var url = form.dataset.url, msg = form.dataset.confirm;
 if (!msg || !confirm(msg)) return;
 var token = form.querySelector('input[name="__RequestVerificationToken"]');
 var body = token ? '__RequestVerificationToken=' + encodeURIComponent(token.value) : '';
 fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' }, body: body })
 .then(function(r) { return r.json(); })
 .then(function(d) { if (typeof showToast === 'function') showToast(d.message, !d.success); if (d.success) location.reload(); })
 .catch(function() { if (typeof showToast === 'function') showToast('Xóa thất bại.', true); });
 });
 });
})();
</script>
}
