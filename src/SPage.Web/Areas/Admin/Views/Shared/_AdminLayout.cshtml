 @* ── Hệ thống ─────────────────────────────────────────── *@
 <li class="pt-4 pb-1.5 px-3">
 <span class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Hệ thống</span>
 </li>

 <li>
 <a asp-area="Admin" asp-controller="Users" asp-action="Index"
 class="@NavClass("Users") flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium transition-colors">
 <svg class="w-[18px] h-[18px] shrink-0" fill="currentColor" viewBox="0 0 20 18">
 <path d="M14 2a3.963 3.963 0 0 0-1.4.267 6.439 6.439 0 0 1-1.331 6.638A4 4 0 1 0 14 2Zm1 9h-1.264A6.957 6.957 0 0 1 15 15v2a2.97 2.97 0 0 1-.184 1H19a1 1 0 0 0 1-1v-1a5.006 5.006 0 0 0-5-5ZM6.5 9a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM8 10H5a5.006 5.006 0 0 0-5 5v1a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-1a5.006 5.006 0 0 0-5-5Z"/>
 </svg>
 <span>Người dùng</span>
 </a>
 </li>

 <li>
 <a asp-area="Admin" asp-controller="Settings" asp-action="Index"
 class="@NavClass("Settings") flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium transition-colors">
 <svg class="w-[18px] h-[18px] shrink-0" fill="currentColor" viewBox="0 0 20 20">
 <path fill-rule="evenodd" d="M7.84 1.804A1 1 0 0 1 8.82 1h2.36a1 1 0 0 1 .98.804l.331 1.652a6.993 6.993 0 0 1 1.929 1.115l1.598-.54a1 1 0 0 1 1.186.447l1.18 2.044a1 1 0 0 1-.205 1.251l-1.267 1.113a7.047 7.047 0 0 1 0 2.228l1.267 1.113a1 1 0 0 1 .205 1.251l-1.18 2.044a1 1 0 0 1-1.186.447l-1.598-.54a6.993 6.993 0 0 1-1.929 1.115l-.33 1.652a1 1 0 0 1-.98.804H8.82a1 1 0 0 1-.98-.804l-.331-1.652a6.993 6.993 0 0 1-1.929-1.115l-1.598.54a1 1 0 0 1-1.186-.447l-1.18-2.044a1 1 0 0 1 .205-1.251l1.267-1.114a7.05 7.05 0 0 1 0-2.227L1.821 7.773a1 1 0 0 1-.205-1.251l1.18-2.044a1 1 0 0 1 1.186-.447l1.598.54A6.992 6.992 0 0 1 7.51 3.456l.33-1.652ZM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" clip-rule="evenodd"/>
 </svg>
 <span>Cấu hình website</span>
 </a>
 </li>

 <li>
 <a asp-area="Admin" asp-controller="Cache" asp-action="Index"
 class="@NavClass("Cache") flex items-center gap-3 px-3 py-2 rounded-xl text-sm font-medium transition-colors">
 <svg class="w-[18px] h-[18px] shrink-0" fill="currentColor" viewBox="0 0 20 20">
 <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0V5.36l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389A5.5 5.5 0 0 1 13.89 6.11l.311.31h-2.432a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z" clip-rule="evenodd"/>
 </svg>
 <span>Xóa cache</span>
 </a>
 </li>

 </ul>
 </div>
 </aside>

 @* ── Main Content ─────────────────────────────────────────────────── *@
 <div class="sm:ml-64 min-h-screen bg-slate-50">
 <div class="p-6 pt-[calc(57px+1.5rem)]">

 @* ── Alert messages ─── *@
 @if (TempData["Success"] is string success)
 {
 <div id="alert-success"
 class="flex items-center gap-3 p-4 mb-5 bg-white border border-slate-200 border-l-4 border-l-emerald-500 rounded-xl shadow-sm"
 role="alert">
 <div class="shrink-0 w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center">
 <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
 <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd"/>
 </svg>
 </div>
 <p class="text-sm font-medium text-slate-700">@success</p>
 <button type="button" data-dismiss-target="#alert-success"
 class="ml-auto p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 14 14">
 <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
 </svg>
 </button>
 </div>
 }

 @if (TempData["Error"] is string error)
 {
 <div class="flex items-center gap-3 p-4 mb-5 bg-white border border-slate-200 border-l-4 border-l-red-500 rounded-xl shadow-sm"
 role="alert">
 <div class="shrink-0 w-8 h-8 rounded-full bg-red-100 flex items-center justify-center">
 <svg class="w-4 h-4 text-red-600" fill="currentColor" viewBox="0 0 20 20">
 <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd"/>
 </svg>
 </div>
 <p class="text-sm font-medium text-slate-700">@error</p>
 </div>
 }

 @RenderBody()
 </div>
 </div>

 @* ★ Toast (dùng sau AJAX delete, v.v.) *@
 <div id="admin-toast" class="fixed bottom-6 right-6 z-[100] hidden items-center gap-3 px-4 py-3 rounded-xl shadow-lg border border-slate-200 bg-white text-slate-700 text-sm font-medium" role="alert">
 <span id="admin-toast-msg"></span>
 </div>
 <script>
 (function() {
 window.showToast = function(msg, isError) {
 var el = document.getElementById('admin-toast');
 var msgEl = document.getElementById('admin-toast-msg');
 if (!el || !msgEl) return;
 msgEl.textContent = msg;
 el.classList.remove('hidden', 'border-l-red-500', 'bg-red-50');
 el.classList.add('flex');
 if (isError) { el.classList.add('border-l-red-500', 'bg-red-50'); }
 el.style.animation = 'none'; el.offsetHeight; el.style.animation = 'admin-toast-in 0.25s ease';
 clearTimeout(el._toastT);
 el._toastT = setTimeout(function() { el.classList.add('hidden'); }, 3500);
 };
 })();
 </script>
 <style>
 @@keyframes admin-toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
 </style>

 @* ★ Flowbite JS *@
 <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>
 @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
