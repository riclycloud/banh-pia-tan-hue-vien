@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<SharedResources> SharedLocalizer
@{
 var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
 var pageTitle = ViewData["Title"]?.ToString() ?? "Admin";
 Func<string, string> NavClass = (ctrl) =>
 currentController.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
 ? "bg-blue-600 text-white"
 : "text-slate-400 hover:bg-white/[0.06] hover:text-slate-200 hover:translate-x-0.5";
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <title>@pageTitle — SPage Admin</title>
 <meta name="robots" content="noindex, nofollow" />

 @* ★ Tailwind CSS CDN *@
 <script src="https://cdn.tailwindcss.com"></script>
 <script>
 tailwind.config = {
 theme: {
 extend: {
 colors: {
 primary: {
 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe',
 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6',
 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a'
 }
 },
 boxShadow: {
 'glow-blue': '0 0 20px rgba(37, 99, 235, 0.3)',
 }
 }
 }
 }
 </script>

 @* ★ Flowbite CSS *@
 <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />
 <link href="~/fonts/googlesans/stylesheet.css" rel="stylesheet" />
 @await RenderSectionAsync("Styles", required: false)
<style>
body {
    font-family: 'Google Sans', sans-serif;
    animation: admin-page-fade-in 0.3s ease-out;
}
/* Smooth scrollbar */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: #1e293b; }
::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: #475569; }
/* Sidebar scrollbar */
#logo-sidebar::-webkit-scrollbar { width: 4px; }
#logo-sidebar::-webkit-scrollbar-track { background: transparent; }
#logo-sidebar::-webkit-scrollbar-thumb { background: #334155; border-radius: 2px; }

@@keyframes admin-page-fade-in {
    from {
        opacity: 0;
        transform: translateY(4px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

 @* ── Top Navigation Bar ─────────────────────────────────────────── *@
 <nav class="fixed top-0 z-50 w-full bg-slate-900 border-b border-slate-700/50">
 <div class="px-4 py-3 lg:px-5">
 <div class="flex items-center justify-between">
 <div class="flex items-center gap-3">
 @* Mobile hamburger *@
 <button data-drawer-target="logo-sidebar" data-drawer-toggle="logo-sidebar"
 aria-controls="logo-sidebar" type="button"
 class="inline-flex items-center p-1.5 text-slate-400 rounded-lg sm:hidden hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-slate-600">
 <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
 <path clip-rule="evenodd" fill-rule="evenodd" d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"/>
 </svg>
 </button>

 @* Logo *@
 <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
 class="flex items-center gap-2">
 <div class="w-7 h-7 rounded-lg bg-blue-600 flex items-center justify-center shadow-sm">
 <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
 <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zm0 6a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2zm0 6a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1v-2z"/>
 </svg>
 </div>
 <span class="text-white font-semibold text-[15px] tracking-tight">
 SPage <span class="text-blue-400 font-normal text-sm">Admin</span>
 </span>
 </a>
 </div>

 <div class="flex items-center gap-3">
 @* View Site *@
 <a href="/" target="_blank"
 class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-300 hover:text-white bg-white/[0.06] hover:bg-white/10 rounded-lg transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
 </svg>
 Xem trang
 </a>

 @* User dropdown *@
 <div class="relative">
 <button type="button" data-dropdown-toggle="user-dropdown"
 class="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-white/10 transition-colors group">
 <div class="w-7 h-7 rounded-full bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center text-white text-xs font-bold shadow-sm">
 @User.Identity?.Name?.FirstOrDefault().ToString().ToUpper()
 </div>
 <span class="hidden md:block text-xs text-slate-300 group-hover:text-white transition-colors max-w-[100px] truncate">
 @User.Identity?.Name
 </span>
 <svg class="w-3 h-3 text-slate-500" fill="currentColor" viewBox="0 0 20 20">
 <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/>
 </svg>
 </button>
 <div id="user-dropdown"
 class="z-50 hidden mt-2 w-52 text-sm bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
 <div class="px-4 py-3 border-b border-slate-100">
 <p class="text-sm font-medium text-slate-800 truncate">@User.Identity?.Name</p>
 <p class="text-xs text-slate-500 truncate mt-0.5">@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
 </div>
 <ul class="py-1">
 <li>
 <a asp-area="" asp-controller="Account" asp-action="ChangePassword"
 class="flex items-center gap-2 px-4 py-2 text-sm text-slate-700 hover:bg-slate-50 transition-colors">
 <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
 </svg>
 Đổi mật khẩu
 </a>
 </li>
 <li>
 <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
 <button type="submit"
 class="w-full flex items-center gap-2 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition-colors">
 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
 </svg>
 Đăng xuất
 </button>
 </form>
 </li>
 </ul>
 </div>
 </div>
 </div>
 </div>
 </div>
 </nav>

