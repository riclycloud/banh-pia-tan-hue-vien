@model SPage.Areas.Admin.Controllers.EditUserViewModel
@{
 ViewData["Title"] = "Sửa người dùng";
}

<h2 class="text-xl font-bold text-gray-800 mb-4">
 Sửa người dùng
</h2>

<form asp-action="Edit" method="post" class="space-y-4 max-w-xl">
 @Html.AntiForgeryToken()
 <input type="hidden" asp-for="Id" />

 <div>
 <label class="block mb-1 text-sm font-medium text-gray-700 ">Email</label>
 <input asp-for="Email" class="block w-full px-3 py-2 text-sm bg-gray-100 border border-gray-300 rounded-lg " readonly />
 </div>

 <div>
 <label asp-for="FullName" class="block mb-1 text-sm font-medium text-gray-700 ">Họ tên</label>
 <input asp-for="FullName" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>

 <div class="flex items-center gap-3">
 <input asp-for="IsActive" type="checkbox"
 class="w-4 h-4 text-primary-600 bg-gray-100 border-gray-300 rounded " />
 <label asp-for="IsActive" class="text-sm text-gray-700 ">Tài khoản hoạt động</label>
 </div>

 <div class="mt-4">
 <h3 class="text-sm font-semibold text-gray-800 mb-2">Vai trò</h3>
 <div class="space-y-2">
 <label class="inline-flex items-center gap-2 text-sm text-gray-700 ">
 <input asp-for="IsAdmin" type="checkbox"
 class="w-4 h-4 text-primary-600 bg-gray-100 border-gray-300 rounded " />
 <span>Admin (toàn quyền quản trị)</span>
 </label>
 <label class="inline-flex items-center gap-2 text-sm text-gray-700 ">
 <input asp-for="IsContentManager" type="checkbox"
 class="w-4 h-4 text-primary-600 bg-gray-100 border-gray-300 rounded " />
 <span>Quản lý nội dung (bài viết, trang, menu, slide)</span>
 </label>
 </div>
 </div>

 <div class="flex items-center gap-3 pt-2">
 <button type="submit" class="px-4 py-2 text-sm text-white bg-primary-600 rounded-lg hover:bg-primary-700">
 Lưu
 </button>
 <a asp-action="Index" class="text-sm text-gray-600 hover:underline ">Quay lại danh sách</a>
 </div>
</form>

