@using SPage.Application.Features.ComponentLibrary.DTOs
@model List<SectionTemplateDto>
@{
    ViewData["Title"] = "Thư viện Section";

    // Group by SectionType
    var grouped = Model.GroupBy(t => t.SectionType).OrderBy(g => g.Key).ToList();

    string TypeColor(string t) => t switch {
        "Hero"         => "violet",
        "Gallery"      => "violet",
        "Testimonials" => "violet",
        "ContactForm"  => "violet",
        "ProductList"  => "violet",
        "TextBlock"    => "green",
        "RichText"     => "green",
        "RawHtml"      => "sky",
        "CssBlock"     => "sky",
        "JsBlock"      => "sky",
        _              => "slate"
    };
    string TypeBadgeCls(string t) {
        var c = TypeColor(t);
        return $"text-xs font-semibold px-2 py-0.5 rounded-full bg-{c}-100 text-{c}-700";
    }
}

@if (TempData["Success"] is string msg)
{
    <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl">@msg</div>
}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-xl font-bold text-slate-800">Thư viện Section</h1>
        <p class="text-sm text-slate-500 mt-0.5">Lưu trữ cấu hình section để tái sử dụng khi xây dựng trang.</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        Thêm template
    </a>
</div>

@if (!Model.Any())
{
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-12 text-center">
        <div class="w-16 h-16 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
        </div>
        <h3 class="text-sm font-semibold text-slate-700 mb-1">Thư viện trống</h3>
        <p class="text-xs text-slate-400 mb-4">Tạo template đầu tiên hoặc lưu section từ trang editor.</p>
        <a asp-action="Create"
           class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-blue-600 bg-blue-50 border border-blue-200 rounded-xl hover:bg-blue-100 transition-colors">
            + Tạo template đầu tiên
        </a>
    </div>
}
else
{
    @foreach (var group in grouped)
    {
        <div class="mb-6">
            <div class="flex items-center gap-2 mb-3">
                <span class="@TypeBadgeCls(group.Key)">@group.Key</span>
                <span class="text-xs text-slate-400">@group.Count() template</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                @foreach (var tpl in group)
                {
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 flex flex-col gap-2 hover:border-blue-300 hover:shadow transition-all group">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex-1 min-w-0">
                                <h3 class="text-sm font-semibold text-slate-800 truncate">@tpl.Name</h3>
                                @if (!string.IsNullOrWhiteSpace(tpl.Description))
                                {
                                    <p class="text-xs text-slate-400 mt-0.5 line-clamp-2">@tpl.Description</p>
                                }
                            </div>
                            <div class="flex gap-1 shrink-0">
                                <a asp-action="Edit" asp-route-id="@tpl.Id"
                                   class="w-7 h-7 flex items-center justify-center rounded-lg text-slate-400 hover:text-blue-600 hover:bg-blue-50 transition-colors" title="Sửa">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </a>
                                <form asp-action="Delete" asp-route-id="@tpl.Id" method="post"
                                      onsubmit="return confirm('Xóa template &quot;@tpl.Name.Replace("\"","")&quot;?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="w-7 h-7 flex items-center justify-center rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors" title="Xóa">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                        <div class="text-[10px] text-slate-400 flex items-center gap-2">
                            <span>📅 @tpl.CreatedAt.ToString("dd/MM/yyyy")</span>
                            @if (!string.IsNullOrWhiteSpace(tpl.CssClass))
                            {
                                <span class="font-mono bg-slate-100 px-1.5 py-0.5 rounded text-[10px]">@tpl.CssClass</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
