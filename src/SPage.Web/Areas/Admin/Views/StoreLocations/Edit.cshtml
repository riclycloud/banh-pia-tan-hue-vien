@using SPage.Domain.Entities.Store
@model StoreLocation
@{
 ViewData["Title"] = Model.Id == 0 ? "Thêm địa chỉ cửa hàng" : "Sửa địa chỉ cửa hàng";
}

<h2 class="text-xl font-bold text-gray-800 mb-4">
 @ViewData["Title"]
</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-4 max-w-3xl">
 @Html.AntiForgeryToken()

 <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
 <div>
 <label asp-for="Name" class="block mb-1 text-sm font-medium text-gray-700 ">
 Tên địa điểm
 </label>
 <input asp-for="Name" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 <div>
 <label asp-for="LandlinePhone" class="block mb-1 text-sm font-medium text-gray-700 ">
 Điện thoại bàn
 </label>
 <input asp-for="LandlinePhone" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 <div>
 <label asp-for="MobilePhone" class="block mb-1 text-sm font-medium text-gray-700 ">
 Di động
 </label>
 <input asp-for="MobilePhone" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 </div>

 <div>
 <label asp-for="FullAddress" class="block mb-1 text-sm font-medium text-gray-700 ">
 Địa chỉ đầy đủ
 </label>
 <textarea asp-for="FullAddress" rows="2"
 class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg "></textarea>
 </div>

 <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
 <div>
 <label asp-for="ProvinceOrCity" class="block mb-1 text-sm font-medium text-gray-700 ">
 Tỉnh/Thành phố
 </label>
 <input asp-for="ProvinceOrCity" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 <div>
 <label asp-for="Country" class="block mb-1 text-sm font-medium text-gray-700 ">
 Quốc gia
 </label>
 <input asp-for="Country" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 <div>
 <label asp-for="ManagerName" class="block mb-1 text-sm font-medium text-gray-700 ">
 Người quản lý
 </label>
 <input asp-for="ManagerName" class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 </div>

 <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
 <div>
 <label asp-for="Latitude" class="block mb-1 text-sm font-medium text-gray-700 ">
 Latitude
 </label>
 <input asp-for="Latitude" type="number" step="0.000001"
 class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 <div>
 <label asp-for="Longitude" class="block mb-1 text-sm font-medium text-gray-700 ">
 Longitude
 </label>
 <input asp-for="Longitude" type="number" step="0.000001"
 class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 <div>
 <label asp-for="MapLink" class="block mb-1 text-sm font-medium text-gray-700 ">
 Link Google Maps
 </label>
 <input asp-for="MapLink"
 class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 </div>

 <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
 <div>
 <label asp-for="LocationType" class="block mb-1 text-sm font-medium text-gray-700 ">
 Loại địa điểm
 </label>
 <select asp-for="LocationType"
 class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg "
 asp-items="Html.GetEnumSelectList<StoreLocationType>()"></select>
 </div>
 <div>
 <label asp-for="RegionType" class="block mb-1 text-sm font-medium text-gray-700 ">
 Khu vực
 </label>
 <select asp-for="RegionType"
 class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg "
 asp-items="Html.GetEnumSelectList<StoreRegionType>()"></select>
 </div>
 <div>
 <label asp-for="SortOrder" class="block mb-1 text-sm font-medium text-gray-700 ">
 Thứ tự
 </label>
 <input asp-for="SortOrder" type="number"
 class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg " />
 </div>
 </div>

 <div class="flex items-center gap-2 mt-2">
 <input asp-for="IsActive" type="checkbox"
 class="w-4 h-4 text-primary-600 bg-gray-100 border-gray-300 rounded " />
 <label asp-for="IsActive" class="text-sm text-gray-700 ">
 Hiển thị trên website
 </label>
 </div>

 <div class="flex items-center gap-3 pt-2">
 <button type="submit" class="px-4 py-2 text-sm text-white bg-primary-600 rounded-lg hover:bg-primary-700">
 Lưu
 </button>
 <a asp-action="Index" class="text-sm text-gray-600 hover:underline ">Quay lại danh sách</a>
 </div>
</form>

@section Scripts {
 <partial name="_ValidationScriptsPartial" />
}

