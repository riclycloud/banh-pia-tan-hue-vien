@using SPage.Domain.Entities.Navigation
@model IEnumerable<MenuLocation>
@{
    ViewData["Title"] = "Vị trí menu";
}

<div class="flex items-center justify-between mb-5">
    <div>
        <h2 class="text-xl font-bold text-slate-800">Vị trí menu</h2>
        <p class="mt-1 text-sm text-slate-500">Quản lý các vị trí hiển thị menu (Header, Footer, Sidebar...)</p>
    </div>
    <a asp-action="Create"
       class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Thêm vị trí
    </a>
</div>

@if (TempData["Success"] is string successMsg)
{
    <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl">@successMsg</div>
}
@if (TempData["Error"] is string errorMsg)
{
    <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl">@errorMsg</div>
}

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
    @if (!Model.Any())
    {
        <div class="px-6 py-12 text-center text-slate-400 text-sm">
            Chưa có vị trí menu nào. Nhấn <strong>Thêm vị trí</strong> để bắt đầu.
        </div>
    }
    else
    {
        <table class="w-full text-sm">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Tên</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Key</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Thứ tự</th>
                    <th class="px-5 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Trạng thái</th>
                    <th class="px-5 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var loc in Model)
                {
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="px-5 py-3 font-medium text-slate-800">@loc.Name</td>
                        <td class="px-5 py-3 font-mono text-xs text-slate-500 bg-slate-50">@loc.Key</td>
                        <td class="px-5 py-3 text-slate-600">@loc.SortOrder</td>
                        <td class="px-5 py-3">
                            @if (loc.IsActive)
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-green-100 text-green-700">Hoạt động</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-500">Ẩn</span>
                            }
                        </td>
                        <td class="px-5 py-3 text-right">
                            <div class="flex items-center justify-end gap-3">
                                <a asp-action="Edit" asp-route-id="@loc.Id"
                                   class="text-xs text-blue-600 hover:underline font-medium">Sửa</a>
                                <form asp-action="Delete" asp-route-id="@loc.Id" method="post" class="inline"
                                      onsubmit="return confirm('Xóa vị trí này?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-xs text-red-500 hover:underline font-medium">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
