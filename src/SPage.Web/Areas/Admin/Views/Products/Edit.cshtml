@model SPage.Areas.Admin.Controllers.ProductFormModel
@{
 ViewData["Title"] = "Sửa sản phẩm";
}

<div class="flex items-center gap-2 mb-5 text-sm">
 <a asp-action="Index" class="text-slate-400 hover:text-blue-600 transition-colors">Sản phẩm</a>
 <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6" />
 </svg>
 <span class="text-slate-600 font-medium truncate max-w-xs">@Model.Name</span>
 <span class="ml-2 px-2 py-0.5 rounded-full bg-slate-100 text-[11px] font-mono text-slate-500">@Model.Id</span>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
 @Html.AntiForgeryToken()
 <input asp-for="Id" type="hidden" />

 <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
 <div class="lg:col-span-2 space-y-4">
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
 <div>
 <label asp-for="Name" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Tên sản phẩm <span class="text-red-500">*</span>
 </label>
 <input asp-for="Name"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 <span asp-validation-for="Name" class="text-xs text-red-500 mt-1 block"></span>
 </div>
 <div>
 <label asp-for="Slug" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Slug (URL)
 </label>
 <div class="flex rounded-xl overflow-hidden border border-slate-200 focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500 transition-colors">
 <span class="px-3 py-2.5 text-xs text-slate-500 bg-slate-50 border-r border-slate-200 shrink-0 flex items-center">/san-pham/</span>
 <input asp-for="Slug" id="product-slug" autocomplete="off"
 class="flex-1 px-3 py-2.5 text-sm bg-white text-slate-900 focus:outline-none font-mono" />
 </div>
 <p class="mt-1 text-xs text-slate-400">Thay đổi slug sẽ tự redirect theo cấu hình SlugController.</p>
 </div>
 </div>

 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div>
 <label asp-for="Price" class="block mb-1.5 text-[13px] font-medium text-slate-600">Giá bán</label>
 <input asp-for="Price" type="number" step="0.01" min="0"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 <span asp-validation-for="Price" class="text-xs text-red-500 mt-1 block"></span>
 </div>
 <div>
 <label asp-for="SalePrice" class="block mb-1.5 text-[13px] font-medium text-slate-600">Giá khuyến mãi</label>
 <input asp-for="SalePrice" type="number" step="0.01" min="0"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 <span asp-validation-for="SalePrice" class="text-xs text-red-500 mt-1 block"></span>
 </div>
 </div>
 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
 <div>
 <label asp-for="SKU" class="block mb-1.5 text-[13px] font-medium text-slate-600">Mã SKU</label>
 <input asp-for="SKU" placeholder="VD: SP-001"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 <div>
 <label asp-for="SortOrder" class="block mb-1.5 text-[13px] font-medium text-slate-600">Thứ tự hiển thị</label>
 <input asp-for="SortOrder" type="number"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 </div>
 </div>

 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <label asp-for="ShortDescription" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Mô tả ngắn
 </label>
 <textarea asp-for="ShortDescription" rows="3" placeholder="Mô tả ngắn hiển thị ở listing..."
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"></textarea>
 </div>

 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <label asp-for="Description" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Mô tả chi tiết
 </label>
 <textarea asp-for="Description" rows="15" id="product-description"
 data-upload-url="@Url.Action("UploadImage", "Media", new { area = "Admin" })"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors font-mono"></textarea>
 </div>

 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">SEO</h3>
 <div class="space-y-4">
 <div>
 <label asp-for="MetaTitle" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Meta Title <span class="text-slate-400 font-normal">(tối đa 70 ký tự)</span>
 </label>
 <input asp-for="MetaTitle" id="meta-title" maxlength="70"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 <div class="flex justify-between mt-1">
 <span asp-validation-for="MetaTitle" class="text-xs text-red-500"></span>
 <span id="meta-title-count" class="text-xs text-slate-400">0/70</span>
 </div>
 </div>
 <div>
 <label asp-for="MetaDescription" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Meta Description <span class="text-slate-400 font-normal">(tối đa 160 ký tự)</span>
 </label>
 <textarea asp-for="MetaDescription" id="meta-desc" rows="2" maxlength="160"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"></textarea>
 <div class="flex justify-between mt-1">
 <span asp-validation-for="MetaDescription" class="text-xs text-red-500"></span>
 <span id="meta-desc-count" class="text-xs text-slate-400">0/160</span>
 </div>
 </div>
 <div>
 <label asp-for="CanonicalUrl" class="block mb-1.5 text-[13px] font-medium text-slate-600">Canonical URL</label>
 <input asp-for="CanonicalUrl" placeholder="https://example.com/san-pham/slug"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 <div class="flex items-center gap-2.5 pt-1">
 <input asp-for="IsIndexable" type="checkbox"
 class="w-4 h-4 accent-blue-600 border-slate-300 rounded" />
 <label asp-for="IsIndexable" class="text-[13px] text-slate-600 cursor-pointer">
 Cho phép Google index trang sản phẩm này
 </label>
 </div>
 </div>
 </div>

 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">Ảnh chính</h3>
 <div class="space-y-2.5">
 <input type="hidden" asp-for="PrimaryImageUrl" id="primary-image-url" />
 <input asp-for="PrimaryImageAlt" placeholder="Alt text ảnh chính"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />

 <input type="file" id="primary-image-file" accept="image/*" class="hidden"
 data-upload-url="@Url.Action("UploadImage", "Media", new { area = "Admin" })" />
 <button type="button"
 class="inline-flex items-center gap-2 px-3 py-2 text-xs font-medium text-slate-700 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors"
 onclick="document.getElementById('primary-image-file').click()">
 <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16m-2-2 1.586-1.586a2 2 0 0 1 2.828 0L20 14m-6-8h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" />
 </svg>
 Upload ảnh
 </button>
 </div>
 </div>
 </div>

 <div class="space-y-4">
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-3">
 Chuyên mục sản phẩm <span class="text-red-500">*</span>
 </h3>
 <select asp-for="CategoryId" asp-items="ViewBag.Categories"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
 <option value="0">-- Chọn chuyên mục --</option>
 </select>
 <span asp-validation-for="CategoryId" class="text-xs text-red-500 mt-1 block"></span>
 </div>

 @* Gallery images *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">Hình phụ (gallery)</h3>
 <div class="space-y-3">
 <div class="border border-slate-100 rounded-xl overflow-hidden">
 <table class="w-full text-sm">
 <thead>
 <tr>
 <th class="bg-slate-50 px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Hình</th>
 <th class="bg-slate-50 px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Alt</th>
 <th class="bg-slate-50 px-3 py-2 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-right">Thao tác</th>
 </tr>
 </thead>
 <tbody class="bg-white">
 @{
 var gallery = ViewBag.Gallery as IEnumerable<SPage.Domain.Entities.Product.ProductImage> ?? Enumerable.Empty<SPage.Domain.Entities.Product.ProductImage>();
 if (!gallery.Any())
 {
 <tr>
 <td colspan="3" class="px-3 py-4 text-xs text-slate-400 text-center">
 Chưa có hình phụ nào.
 </td>
 </tr>
 }
 else
 {
 foreach (var img in gallery)
 {
 <tr class="border-b border-slate-100">
 <td class="px-3 py-2">
 <div class="flex items-center gap-2">
 <img src="@img.ImageUrl" alt="@img.AltText" class="w-12 h-12 object-cover rounded-lg border border-slate-200" />
 <span class="text-xs text-slate-500 break-all">@img.ImageUrl</span>
 </div>
 </td>
 <td class="px-3 py-2 text-xs text-slate-600">
 @img.AltText
 </td>
 <td class="px-3 py-2 text-right">
 <form asp-action="DeleteImage" method="post" class="inline"
 asp-route-id="@img.Id" asp-route-productId="@Model.Id"
 onsubmit="return confirm('Xóa hình này?');">
 @Html.AntiForgeryToken()
 <button type="submit"
 class="inline-flex items-center gap-1 text-[11px] font-medium text-red-500 hover:text-red-600 hover:bg-red-50 px-2.5 py-1.5 rounded-lg transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16" />
 </svg>
 Xóa
 </button>
 </form>
 </td>
 </tr>
 }
 }
 }
 </tbody>
 </table>
 </div>

 <form asp-action="AddImage" method="post" class="space-y-2">
 @Html.AntiForgeryToken()
 <input type="hidden" name="productId" value="@Model.Id" />
 <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
 <div class="md:col-span-2">
 <label class="block mb-1 text-[12px] font-medium text-slate-600">
 URL hình
 </label>
 <input type="text" name="imageUrl" id="gallery-image-url"
 placeholder="/uploads/products/image.webp"
 class="block w-full px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 <div>
 <label class="block mb-1 text-[12px] font-medium text-slate-600">
 Alt
 </label>
 <input type="text" name="altText"
 placeholder="Alt text"
 class="block w-full px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 </div>
 <div class="flex items-center gap-2">
 <input type="file" id="gallery-image-file" accept="image/*" class="hidden"
 data-upload-url="@Url.Action("UploadImage", "Media", new { area = "Admin" })" />
 <button type="button"
 class="inline-flex items-center gap-2 px-3 py-2 text-xs font-medium text-slate-700 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors"
 onclick="document.getElementById('gallery-image-file').click()">
 <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16m-2-2 1.586-1.586a2 2 0 0 1 2.828 0L20 14m-6-8h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" />
 </svg>
 Upload & tự điền URL
 </button>
 <button type="submit"
 class="inline-flex items-center gap-2 px-4 py-2 text-xs font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
 Thêm hình phụ
 </button>
 </div>
 </form>
 </div>
 </div>

 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">Trạng thái</h3>
 <div class="space-y-2.5 mb-3">
 <div class="flex items-center gap-2">
 <input asp-for="IsActive" type="checkbox"
 class="w-4 h-4 accent-emerald-600 border-slate-300 rounded" />
 <label asp-for="IsActive" class="text-[13px] text-slate-600 cursor-pointer">
 Hiển thị sản phẩm trên website
 </label>
 </div>
 <div class="flex items-center gap-2">
 <input asp-for="IsNew" type="checkbox"
 class="w-4 h-4 accent-blue-600 border-slate-300 rounded" />
 <label asp-for="IsNew" class="text-[13px] text-slate-600 cursor-pointer">
 Sản phẩm mới
 </label>
 </div>
 <div class="flex items-center gap-2">
 <input asp-for="IsFeatured" type="checkbox"
 class="w-4 h-4 accent-amber-500 border-slate-300 rounded" />
 <label asp-for="IsFeatured" class="text-[13px] text-slate-600 cursor-pointer">
 Sản phẩm nổi bật
 </label>
 </div>
 <div class="flex items-center gap-2">
 <input asp-for="IsPromotion" type="checkbox"
 class="w-4 h-4 accent-red-500 border-slate-300 rounded" />
 <label asp-for="IsPromotion" class="text-[13px] text-slate-600 cursor-pointer">
 Sản phẩm khuyến mãi
 </label>
 </div>
 </div>
 <div class="flex gap-2 pt-3 border-t border-slate-100">
 <button type="submit"
 class="flex-1 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
 Cập nhật sản phẩm
 </button>
 <a asp-action="Index"
 class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
 Quay lại
 </a>
 </div>
 </div>

 <a href="/san-pham/@Model.Slug" target="_blank"
 class="flex items-center gap-2.5 p-3.5 text-sm text-slate-600 bg-slate-50 border border-slate-200 rounded-xl hover:bg-slate-100 transition-colors">
 <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
 </svg>
 Xem sản phẩm trên trang
 </a>
 </div>
 </div>
</form>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/7.1.1/tinymce.min.js"></script>
<script src="~/js/admin-products.js"></script>
}

