@{
 ViewData["Title"] = "Sản phẩm";
}

@* ── Page Header ──────────────────────────────────────────────────────────── *@
<div class="flex items-center justify-between mb-5">
 <div>
 <h1 class="text-xl font-bold text-slate-800">Sản phẩm</h1>
 <p class="text-sm text-slate-500 mt-0.5">Trang @ViewBag.Page / @ViewBag.TotalPages</p>
 </div>
 <div class="flex items-center gap-2">
 <a asp-action="Create"
 class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
 <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
 <path d="M10 5a1 1 0 0 1 1 1v3h3a1 1 0 1 1 0 2h-3v3a1 1 0 1 1-2 0v-3H6a1 1 0 1 1 0-2h3V6a1 1 0 0 1 1-1Z" />
 </svg>
 Thêm sản phẩm
 </a>
 </div>
</div>

@* ── Search ────────────────────────────────────────────────────────────────── *@
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 mb-4">
 <form method="get" class="flex flex-wrap gap-2.5 items-center">
 <div class="relative flex-1 min-w-[200px]">
 <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
 <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0z"/>
 </svg>
 </div>
 <input type="text" name="q" value="@ViewBag.SearchTerm" placeholder="Tìm sản phẩm..."
 class="block w-full pl-9 pr-3 py-2 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 <div>
 <select name="categoryId"
 class="block w-full px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
 <option value="">-- Tất cả chuyên mục --</option>
 @foreach (var cat in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Categories)
 {
 var selected = cat.Selected ? "selected" : "";
 <option value="@cat.Value" selected >@cat.Text</option>
 }
 </select>
 </div>
 <button type="submit"
 class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"/>
 </svg>
 Lọc
 </button>
 </form>
</div>

@* ── Table ─────────────────────────────────────────────────────────────────── *@
<div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm">
 <table class="w-full text-sm text-left">
 <thead>
 <tr>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 w-14">Ảnh</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Tên sản phẩm</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 hidden md:table-cell">Slug</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-right">Giá</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-center">Trạng thái</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 hidden sm:table-cell">Ngày tạo</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-right">Thao tác</th>
 </tr>
 </thead>
 <tbody class="bg-white">
 @foreach (var item in (dynamic)Model)
 {
 <tr class="border-b border-slate-100 hover:bg-slate-50/60 transition-colors">
 <td class="px-4 py-3 align-middle">
 @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
 {
 <img src="@item.ThumbnailUrl" alt="@item.Name" class="w-12 h-12 rounded-lg object-cover border border-slate-200 bg-slate-50" loading="lazy" />
 }
 else
 {
 <div class="w-12 h-12 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center shrink-0" title="Chưa có ảnh">
 <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
 </div>
 }
 </td>
 <td class="px-4 py-3 font-medium text-slate-800">@item.Name</td>
 <td class="px-4 py-3 text-slate-500 font-mono text-xs hidden md:table-cell">
 <div class="flex items-center gap-1.5">
 <span>@item.Slug</span>
 <a href="/san-pham/@item.Slug" target="_blank" class="text-slate-400 hover:text-blue-600 transition-colors" title="Xem trên web">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
 </svg>
 </a>
 </div>
 </td>
 <td class="px-4 py-3 text-right text-slate-700 font-medium">@item.Price.ToString("N0") đ</td>
 <td class="px-4 py-3 text-center">
 @if (item.IsActive)
 {
 <span class="bg-emerald-100 text-emerald-700 text-xs font-medium px-2.5 py-0.5 rounded-full whitespace-nowrap">Hoạt động</span>
 }
 else
 {
 <span class="bg-slate-100 text-slate-600 text-xs font-medium px-2.5 py-0.5 rounded-full whitespace-nowrap">Ẩn</span>
 }
 </td>
 <td class="px-4 py-3 text-slate-500 text-[13px] hidden sm:table-cell">
 @item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
 </td>
 <td class="px-4 py-3 text-right space-x-1">
 <a asp-action="Edit" asp-route-id="@item.Id"
 class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 px-2.5 py-1.5 rounded-lg transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232 18.768 8.768M4 20h4l10-10-4-4L4 16v4z" />
 </svg>
 Sửa
 </a>
 <form class="inline js-delete-form" data-confirm="Bạn có chắc muốn xóa sản phẩm «@item.Name»?" data-url="@Url.Action("Delete", "Products", new { area = "Admin", id = item.Id })">
 @Html.AntiForgeryToken()
 <button type="button" class="js-delete-btn inline-flex items-center gap-1 text-xs font-medium text-red-500 hover:text-red-600 hover:bg-red-50 px-2.5 py-1.5 rounded-lg transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16" />
 </svg>
 Xóa
 </button>
 </form>
 </td>
 </tr>
 }

 @{
 var items = (dynamic)Model;
 bool isEmpty = true;
 foreach (var _ in items) { isEmpty = false; break; }
 if (isEmpty)
 {
 <tr>
 <td colspan="7" class="px-4 py-12 text-center">
 <div class="flex flex-col items-center gap-2 text-slate-400">
 <svg class="w-10 h-10 opacity-40" fill="currentColor" viewBox="0 0 18 20">
 <path d="M17 5.923A1 1 0 0 0 16 5h-3V4a4 4 0 1 0-8 0v1H2a1 1 0 0 0-1 .923L.086 17.846A2 2 0 0 0 2.08 20h13.84a2 2 0 0 0 1.994-2.153L17 5.923ZM7 9a1 1 0 0 1-2 0V7h2v2Zm0-5a2 2 0 1 1 4 0v1H7V4Zm6 5a1 1 0 1 1-2 0V7h2v2Z"/>
 </svg>
 <p class="text-sm">Chưa có sản phẩm nào.</p>
 </div>
 </td>
 </tr>
 }
 }
 </tbody>
 </table>
</div>

@* ── Pagination ───────────────────────────────────────────────────────── *@
@{
 var currentPage = (int)ViewBag.Page;
 var totalPages = (int)ViewBag.TotalPages;
}
@if (totalPages > 1)
{
 <nav class="flex items-center justify-center gap-1.5 mt-5" aria-label="Phân trang sản phẩm">
 @if (currentPage > 1)
 {
 <a asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-q="@ViewBag.SearchTerm" asp-route-categoryId="@ViewBag.CategoryId"
 class="px-3 py-1.5 text-sm text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors" rel="prev">‹ Trước</a>
 }
 @for (var i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
 {
 <a asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-page="@i" asp-route-q="@ViewBag.SearchTerm" asp-route-categoryId="@ViewBag.CategoryId"
 class="px-3 py-1.5 text-sm rounded-xl border transition-colors @(i == currentPage ? "bg-blue-600 text-white border-blue-600 font-medium" : "text-slate-600 bg-white border-slate-200 hover:bg-slate-50")">
 @i
 </a>
 }
 @if (currentPage < totalPages)
 {
 <a asp-area="Admin" asp-controller="Products" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-q="@ViewBag.SearchTerm" asp-route-categoryId="@ViewBag.CategoryId"
 class="px-3 py-1.5 text-sm text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors" rel="next">Sau ›</a>
 }
 </nav>
}

@section Scripts {
<script>
(function() {
 document.querySelectorAll('.js-delete-form').forEach(function(form) {
 var btn = form.querySelector('.js-delete-btn');
 if (!btn) return;
 btn.addEventListener('click', function() {
 var url = form.dataset.url, msg = form.dataset.confirm;
 if (!msg || !confirm(msg)) return;
 var token = form.querySelector('input[name="__RequestVerificationToken"]');
 var body = token ? '__RequestVerificationToken=' + encodeURIComponent(token.value) : '';
 fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' }, body: body })
 .then(function(r) { return r.json(); })
 .then(function(d) { if (typeof showToast === 'function') showToast(d.message, !d.success); if (d.success) location.reload(); })
 .catch(function() { if (typeof showToast === 'function') showToast('Xóa thất bại.', true); });
 });
 });
})();
</script>
}
