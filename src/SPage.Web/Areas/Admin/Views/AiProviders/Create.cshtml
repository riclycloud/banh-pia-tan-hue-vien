@model SPage.Areas.Admin.Controllers.AiProviderConfigModel
@{
    ViewData["Title"] = "Thêm API Key AI";
}

<div class="mb-5">
    <a asp-action="Index" class="text-sm text-slate-500 hover:text-slate-700">← API Key AI</a>
</div>

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6 max-w-xl">
    <h1 class="text-xl font-bold text-slate-800 mb-4">Thêm API Key AI</h1>

    <form asp-action="Create" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-sm text-red-600 mb-4"></div>

        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Provider <span class="text-red-500">*</span></label>
            <select asp-for="ProviderKey" class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                <option value="">-- Chọn --</option>
                <option value="Gemini">Google Gemini</option>
                <option value="OpenAI">OpenAI (ChatGPT)</option>
                <option value="Grok">xAI (Grok)</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Tên hiển thị</label>
            <input asp-for="DisplayName" type="text" class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="VD: Gemini của tôi" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">API Key <span class="text-red-500">*</span></label>
            <input asp-for="ApiKey" type="password" class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="sk-... hoặc AIza..." autocomplete="off" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Base URL (tùy chọn)</label>
            <input asp-for="BaseUrl" type="url" class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Để trống dùng mặc định" />
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Model (tùy chọn)</label>
            <input asp-for="ModelName" type="text" class="block w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="VD: gemini-1.5-flash, gpt-4o-mini" />
        </div>
        <div>
            <label class="inline-flex items-center gap-2 cursor-pointer">
                <input asp-for="IsActive" type="checkbox" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                <span class="text-sm text-slate-700">Bật (dùng trong công cụ SEO)</span>
            </label>
        </div>
        <div class="flex gap-2 pt-2">
            <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors">Thêm</button>
            <a asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">Hủy</a>
        </div>
    </form>
</div>
