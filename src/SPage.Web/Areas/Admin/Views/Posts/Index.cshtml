@using SPage.Application.Common.Models
@using SPage.Application.Features.Posts.DTOs
@using SPage.Domain.Enums
@model PaginatedResult<PostAdminDto>
@{
 ViewData["Title"] = "Bài viết";
 var currentPage = Model.Page;
 var totalPages = Model.TotalPages;
}

@* ── Page Header ──────────────────────────────────────────────────────── *@
<div class="flex items-center justify-between mb-5">
 <div>
 <h1 class="text-xl font-bold text-slate-800">Bài viết</h1>
 <p class="text-sm text-slate-500 mt-0.5">@Model.TotalCount bài viết trong hệ thống</p>
 </div>
 <a asp-action="Create"
 class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
 <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
 <path d="M10 5a1 1 0 0 1 1 1v3h3a1 1 0 1 1 0 2h-3v3a1 1 0 1 1-2 0v-3H6a1 1 0 1 1 0-2h3V6a1 1 0 0 1 1-1Z"/>
 </svg>
 Thêm bài viết
 </a>
</div>

@* ── Search + Filter ──────────────────────────────────────────────────── *@
<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 mb-4">
 <form method="get" class="flex flex-wrap gap-2.5">
 <div class="relative flex-1 min-w-[200px]">
 <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
 <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m21 21-6-6m2-5a7 7 0 1 1-14 0 7 7 0 0 1 14 0z"/>
 </svg>
 </div>
 <input type="text" name="q" value="@ViewBag.SearchTerm" placeholder="Tìm tiêu đề..."
 class="block w-full pl-9 pr-3 py-2 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 <select name="status"
 class="px-3 py-2 text-sm bg-white border border-slate-200 rounded-xl text-slate-700 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
 <option value="">Tất cả trạng thái</option>
 @foreach (PostStatus s in Enum.GetValues(typeof(PostStatus)))
 {
 <option value="@s" selected="@(ViewBag.Status?.ToString() == s.ToString())">@s</option>
 }
 </select>
 <button type="submit"
 class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-slate-700 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"/>
 </svg>
 Lọc
 </button>
 @if (!string.IsNullOrEmpty(ViewBag.SearchTerm?.ToString()) || ViewBag.Status != null)
 {
 <a asp-area="Admin" asp-controller="Posts" asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-slate-500 hover:text-slate-700 transition-colors">
 Xóa bộ lọc
 </a>
 }
 </form>
</div>

@* ── Table ────────────────────────────────────────────────────────────── *@
<div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm">
 <table class="w-full text-sm text-left">
 <thead>
 <tr>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 w-14">Ảnh</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Tiêu đề</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 hidden sm:table-cell">Chuyên mục</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200">Trạng thái</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 hidden md:table-cell">Ngày tạo</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 hidden lg:table-cell text-right">Lượt xem</th>
 <th class="bg-slate-50 px-4 py-3 text-[11px] font-semibold uppercase tracking-wide text-slate-500 border-b border-slate-200 text-right">Thao tác</th>
 </tr>
 </thead>
 <tbody class="bg-white">
 @foreach (var post in Model.Items)
 {
 <tr class="border-b border-slate-100 hover:bg-slate-50/60 transition-colors">
 <td class="px-4 py-3 align-middle">
 @if (!string.IsNullOrWhiteSpace(post.FeaturedImageUrl))
 {
 <img src="@post.FeaturedImageUrl" alt="@(post.FeaturedImageAlt ?? post.Title)" class="w-12 h-12 rounded-lg object-cover border border-slate-200 bg-slate-50" loading="lazy" />
 }
 else
 {
 <div class="w-12 h-12 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center shrink-0" title="Chưa có ảnh">
 <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
 </div>
 }
 </td>
 <td class="px-4 py-3 font-medium text-slate-800 max-w-xs">
 <div class="truncate max-w-[240px]">@post.Title</div>
 @if (!post.IsIndexable)
 {
 <span class="text-[10px] text-red-500 font-normal">noindex</span>
 }
 <div class="flex items-center gap-1.5 mt-0.5">
 <div class="text-[11px] text-slate-400 font-normal truncate max-w-[240px]">/@post.Slug</div>
 <a href="/@post.Slug" target="_blank" class="text-slate-400 hover:text-blue-600 transition-colors" title="Xem trên web">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
 </svg>
 </a>
 </div>
 </td>
 <td class="px-4 py-3 text-slate-600 hidden sm:table-cell">@post.CategoryName</td>
 <td class="px-4 py-3">
 @{
 var (badgeClass, badgeLabel) = post.Status switch
 {
 PostStatus.Published => ("bg-emerald-100 text-emerald-700", "Đã xuất bản"),
 PostStatus.Draft => ("bg-slate-100 text-slate-600", "Nháp"),
 PostStatus.Scheduled => ("bg-amber-100 text-amber-700", "Đã lên lịch"),
 _ => ("bg-slate-100 text-slate-600", post.Status.ToString())
 };
 }
 <span class="@badgeClass text-xs font-medium px-2.5 py-0.5 rounded-full whitespace-nowrap">@badgeLabel</span>
 </td>
 <td class="px-4 py-3 text-slate-500 whitespace-nowrap text-[13px] hidden md:table-cell">
 @post.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
 </td>
 <td class="px-4 py-3 text-slate-500 text-[13px] hidden lg:table-cell text-right">
 @post.ViewCount.ToString("N0")
 </td>
 <td class="px-4 py-3 text-right whitespace-nowrap">
 <a asp-action="Edit" asp-route-id="@post.Id"
 class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-700 hover:bg-blue-50 px-2.5 py-1.5 rounded-lg transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15.232 5.232 3.536 3.536m-2.036-5.036a2.5 2.5 0 0 1 3.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
 </svg>
 Sửa
 </a>
 <form class="inline js-delete-form" data-confirm="Bạn có chắc muốn xóa bài viết «@post.Title»?" data-url="@Url.Action("Delete", "Posts", new { area = "Admin", id = post.Id })">
 @Html.AntiForgeryToken()
 <button type="button" class="js-delete-btn inline-flex items-center gap-1 text-xs font-medium text-red-500 hover:text-red-600 hover:bg-red-50 px-2.5 py-1.5 rounded-lg transition-colors">
 <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0 1 16.138 21H7.862a2 2 0 0 1-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v3M4 7h16"/>
 </svg>
 Xóa
 </button>
 </form>
 </td>
 </tr>
 }

 @if (!Model.Items.Any())
 {
 <tr>
 <td colspan="7" class="px-4 py-12 text-center">
 <div class="flex flex-col items-center gap-2 text-slate-400">
 <svg class="w-10 h-10 opacity-40" fill="currentColor" viewBox="0 0 20 18">
 <path d="M18 0H2a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2Zm-5.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm4.376 10.481A1 1 0 0 1 16 15H4a1 1 0 0 1-.895-1.447l3.5-7A1 1 0 0 1 7.468 6a.965.965 0 0 1 .9.5l2.775 4.757 1.546-1.887a1 1 0 0 1 1.618.1l2.541 4a1 1 0 0 1 .028 1.011Z"/>
 </svg>
 <p class="text-sm">Chưa có bài viết nào.</p>
 <a asp-action="Create" class="text-sm text-blue-600 hover:underline mt-1">Tạo bài viết đầu tiên →</a>
 </div>
 </td>
 </tr>
 }
 </tbody>
 </table>
</div>

@* ── Pagination ───────────────────────────────────────────────────────── *@
@if (totalPages > 1)
{
 <nav class="flex items-center justify-center gap-1.5 mt-5">
 @if (currentPage > 1)
 {
 <a asp-area="Admin" asp-controller="Posts" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-q="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status"
 class="px-3 py-1.5 text-sm text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors">‹</a>
 }
 @for (var i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
 {
 <a asp-area="Admin" asp-controller="Posts" asp-action="Index" asp-route-page="@i" asp-route-q="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status"
 class="px-3 py-1.5 text-sm rounded-xl border transition-colors @(i == currentPage ? "bg-blue-600 text-white border-blue-600 font-medium" : "text-slate-600 bg-white border-slate-200 hover:bg-slate-50")">
 @i
 </a>
 }
 @if (currentPage < totalPages)
 {
 <a asp-area="Admin" asp-controller="Posts" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-q="@ViewBag.SearchTerm" asp-route-status="@ViewBag.Status"
 class="px-3 py-1.5 text-sm text-slate-600 bg-white border border-slate-200 rounded-xl hover:bg-slate-50 transition-colors">›</a>
 }
 </nav>
}

@section Scripts {
<script>
(function() {
 document.querySelectorAll('.js-delete-form').forEach(function(form) {
 var btn = form.querySelector('.js-delete-btn');
 if (!btn) return;
 btn.addEventListener('click', function() {
 if (btn.disabled) return;
 var url = form.dataset.url, msg = form.dataset.confirm;
 if (!msg || !confirm(msg)) return;
 var token = form.querySelector('input[name="__RequestVerificationToken"]');
 var body = token ? '__RequestVerificationToken=' + encodeURIComponent(token.value) : '';
 fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' }, body: body })
 .then(function(r) { return r.json(); })
 .then(function(d) { if (typeof showToast === 'function') showToast(d.message, !d.success); if (d.success) location.reload(); })
 .catch(function() { if (typeof showToast === 'function') showToast('Xóa thất bại.', true); });
 });
 });
})();
</script>
}
