@model SPage.Areas.Admin.Controllers.PostFormModel
@using SPage.Domain.Enums
@{
 ViewData["Title"] = "Sửa bài viết";
}

@* ── Breadcrumb ──────────────────────────────────────────────────────────── *@
<div class="flex items-center gap-2 mb-5 text-sm">
 <a asp-action="Index" class="text-slate-400 hover:text-blue-600 transition-colors">Bài viết</a>
 <svg class="w-3.5 h-3.5 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 18 6-6-6-6"/>
 </svg>
 <span class="text-slate-600 font-medium truncate max-w-xs">@Model.Title</span>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post">
 @Html.AntiForgeryToken()
 <input asp-for="Id" type="hidden" />

 <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">

 @* ── Main Content ── *@
 <div class="lg:col-span-2 space-y-4">

 @* Title + Slug *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 space-y-4">
 <div>
 <label asp-for="Title" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Tiêu đề <span class="text-red-500">*</span>
 </label>
 <input asp-for="Title"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 <span asp-validation-for="Title" class="text-xs text-red-500 mt-1 block"></span>
 </div>
 <div>
 <label asp-for="Slug" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Slug (URL) <span class="text-slate-400 font-normal">— để trống sẽ tự sinh từ tiêu đề</span>
 </label>
 <div class="flex rounded-xl overflow-hidden border border-slate-200 focus-within:ring-2 focus-within:ring-blue-500 focus-within:border-blue-500 transition-colors">
 <span class="px-3 py-2.5 text-xs text-slate-500 bg-slate-50 border-r border-slate-200 shrink-0 flex items-center">/</span>
 <input asp-for="Slug" id="post-slug" autocomplete="off"
 class="flex-1 px-3 py-2.5 text-sm bg-white text-slate-900 focus:outline-none font-mono" />
 </div>
 <p class="mt-1 text-xs text-slate-400">Thay đổi slug sẽ tự tạo redirect 301 từ slug cũ.</p>
 </div>
 </div>

 @* Content *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <label asp-for="Content" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Nội dung <span class="text-red-500">*</span>
 </label>
 <textarea asp-for="Content" rows="15" id="content-editor"
 data-upload-url="@Url.Action("UploadImage", "Media", new { area = "Admin" })"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors font-mono"></textarea>
 <span asp-validation-for="Content" class="text-xs text-red-500 mt-1 block"></span>
 </div>

 @* Excerpt *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <label asp-for="Excerpt" class="block mb-1.5 text-[13px] font-medium text-slate-600">Tóm tắt</label>
 <textarea asp-for="Excerpt" rows="3" placeholder="Mô tả ngắn về bài viết..."
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"></textarea>
 </div>

 @* SEO *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">SEO</h3>
 <div class="space-y-4">
 <div>
 <label asp-for="MetaTitle" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Meta Title <span class="text-slate-400 font-normal">(tối đa 70 ký tự)</span>
 </label>
 <input asp-for="MetaTitle" id="meta-title" maxlength="70"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 <div class="flex justify-between mt-1">
 <span asp-validation-for="MetaTitle" class="text-xs text-red-500"></span>
 <span id="meta-title-count" class="text-xs text-slate-400">0/70</span>
 </div>
 </div>
 <div>
 <label asp-for="MetaDescription" class="block mb-1.5 text-[13px] font-medium text-slate-600">
 Meta Description <span class="text-slate-400 font-normal">(tối đa 160 ký tự)</span>
 </label>
 <textarea asp-for="MetaDescription" id="meta-desc" rows="2" maxlength="160"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"></textarea>
 <div class="flex justify-between mt-1">
 <span asp-validation-for="MetaDescription" class="text-xs text-red-500"></span>
 <span id="meta-desc-count" class="text-xs text-slate-400">0/160</span>
 </div>
 </div>
 <div>
 <label asp-for="CanonicalUrl" class="block mb-1.5 text-[13px] font-medium text-slate-600">Canonical URL</label>
 <input asp-for="CanonicalUrl" placeholder="https://example.com/blog/slug"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
 </div>
 <div class="flex items-center gap-2.5 pt-1">
 <input asp-for="IsIndexable" type="checkbox"
 class="w-4 h-4 accent-blue-600 border-slate-300 rounded" />
 <label asp-for="IsIndexable" class="text-[13px] text-slate-600 cursor-pointer">
 Cho phép Google index trang này
 </label>
 </div>
 </div>
 </div>

 @* Featured Image *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">Ảnh đại diện</h3>
 <div class="space-y-2.5">
 <input type="hidden" asp-for="FeaturedImageUrl" id="featured-image-url" />
 
 <img id="featured-image-preview" src="@Model.FeaturedImageUrl" alt="Preview" class="@(string.IsNullOrEmpty(Model.FeaturedImageUrl) ? "hidden" : "") w-full h-auto mt-2 rounded-xl border border-slate-200 object-cover" />

 <input asp-for="FeaturedImageAlt" placeholder="Alt text"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 placeholder-slate-400 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />

 <input type="file" id="featured-image-file" accept="image/*" class="hidden"
 data-upload-url="@Url.Action("UploadImage", "Media", new { area = "Admin" })" />
 <button type="button"
 class="inline-flex items-center gap-2 px-3 py-2 text-xs font-medium text-slate-700 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors mt-2"
 onclick="document.getElementById('featured-image-file').click()">
 <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 0 1 2.828 0L16 16m-2-2 1.586-1.586a2 2 0 0 1 2.828 0L20 14m-6-8h.01M6 20h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z" />
 </svg>
 Upload ảnh
 </button>
 </div>
 </div>
 </div>

 @* ── Sidebar ── *@
 <div class="space-y-4">

 @* Publish box *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-4">Xuất bản</h3>
 <div class="space-y-3 mb-4">
 <div>
 <label asp-for="Status" class="block mb-1.5 text-[13px] font-medium text-slate-600">Trạng thái</label>
 <select asp-for="Status" asp-items="Html.GetEnumSelectList<PostStatus>()"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors"></select>
 </div>
 <div>
 <label asp-for="SchemaType" class="block mb-1.5 text-[13px] font-medium text-slate-600">Schema.org</label>
 <select asp-for="SchemaType"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
 <option value="Article">Article</option>
 <option value="NewsArticle">NewsArticle</option>
 <option value="BlogPosting">BlogPosting</option>
 </select>
 </div>
 </div>
 <div class="flex gap-2 pt-3 border-t border-slate-100">
 <button type="submit"
 class="flex-1 px-4 py-2 text-sm font-medium text-white bg-blue-600 rounded-xl hover:bg-blue-700 transition-colors shadow-sm">
 Cập nhật
 </button>
 <a asp-action="Index"
 class="px-4 py-2 text-sm font-medium text-slate-600 bg-slate-100 rounded-xl hover:bg-slate-200 transition-colors">
 Hủy
 </a>
 </div>
 </div>

 @* Category *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-3">
 Chuyên mục <span class="text-red-500">*</span>
 </h3>
 <select asp-for="CategoryId" asp-items="ViewBag.Categories"
 class="block w-full px-3 py-2.5 text-sm bg-white border border-slate-200 rounded-xl text-slate-900 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
 <option value="0">-- Chọn chuyên mục --</option>
 </select>
 <span asp-validation-for="CategoryId" class="text-xs text-red-500 mt-1 block"></span>
 </div>

 @* Tags *@
 <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
 <h3 class="text-sm font-semibold text-slate-700 mb-3">Thẻ tag</h3>
 <div class="space-y-2 max-h-52 overflow-y-auto pr-1">
 @foreach (var tag in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Tags)
 {
 <label class="flex items-center gap-2.5 text-[13px] text-slate-600 cursor-pointer hover:text-slate-800 transition-colors">
 <input type="checkbox" name="TagIds" value="@tag.Value"
 class="w-4 h-4 accent-blue-600 border-slate-300 rounded"
 @(tag.Selected ? "checked" : "") />
 @tag.Text
 </label>
 }
 </div>
 </div>

 @* View on site *@
 <a href="/@Model.Slug" target="_blank"
 class="flex items-center gap-2.5 p-3.5 text-sm text-slate-600 bg-slate-50 border border-slate-200 rounded-xl hover:bg-slate-100 transition-colors">
 <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
 </svg>
 Xem bài viết trên trang
 </a>
 </div>
 </div>
</form>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/7.1.1/tinymce.min.js"></script>
<script src="~/js/admin-posts.js"></script>
}
