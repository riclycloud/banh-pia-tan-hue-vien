                        </a>
                    </div>
                </div>

                @* Quick links *@
                <div class="footer-col">
                    <h3 class="footer-col__title">Liên kết nhanh</h3>
                    <ul class="footer-col__list">
                        <li><a href="/about">Giới thiệu</a></li>
                        <li><a href="/about/history">Lịch sử hình thành</a></li>
                        <li><a href="/nha-xuong">Nhà xưởng</a></li>
                        <li><a href="/chung-nhan">Chứng nhận</a></li>
                        <li><a href="/dai-ly">Đại lý</a></li>
