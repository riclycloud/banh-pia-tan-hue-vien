                    <a href="/" class="footer-brand__logo">
                        <img src="~/logo/logo-40-nam.png" alt="@settings.SiteName" class="footer-brand__logo-img" />
                    </a>
                    @if (!string.IsNullOrWhiteSpace(settings.DefaultMetaDescription))
                    {
                        <p class="footer-brand__desc">@settings.DefaultMetaDescription</p>
