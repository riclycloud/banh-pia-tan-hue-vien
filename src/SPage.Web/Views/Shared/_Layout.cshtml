@using Microsoft.AspNetCore.Mvc.Localization
@using SPage.ViewModels.Seo
@inject IViewLocalizer Localizer
@inject IHtmlLocalizer<SharedResources> SharedLocalizer
@using SPage.Application.Common.Interfaces
@inject ISiteSettingsService SiteSettingsService

@{
    var settings = await SiteSettingsService.GetAsync();
    var currentYear = DateTime.Now.Year;
    var path = Context.Request.Path.Value ?? "/";
    Func<string, string> IsActive = p =>
        (p == "/" ? path == "/" : path.StartsWith(p, StringComparison.OrdinalIgnoreCase)) ? "active" : "";

    // ── SEO auto-fallback ─────────────────────────────────────────────────────
    // Bất kỳ controller nào không set ViewData["Seo"] sẽ tự động nhận
    // SeoViewModel mặc định từ ViewData["Title"] + site settings.
    if (ViewData["Seo"] is not SeoViewModel)
    {
        var _fbTitle = ViewData["Title"]?.ToString();
        ViewData["Seo"] = new SeoViewModel
        {
            Title           = !string.IsNullOrWhiteSpace(_fbTitle)
                                  ? $"{_fbTitle} — {settings.SiteName}"
                                  : settings.SiteName,
            MetaDescription = settings.DefaultMetaDescription,
            IsIndexable     = true,
            OgType          = "website"
        };
    }
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <seo-head />
    @await Component.InvokeAsync("SiteHeadSnippet")
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.min.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</head>
<body>
<a href="#main-content" class="skip-link">Bỏ qua điều hướng</a>
<div id="cursor-glow" aria-hidden="true"></div>

@* ══════════════════════════════════════════════════════════
   HEADER — Logo left + two-row right (utility + main nav)
══════════════════════════════════════════════════════════ *@
<header class="site-header" id="site-header">
    <div class="hd-container header-inner">

        @* Logo — spans full header height *@
        <a class="main-logo" asp-controller="Home" asp-action="Index" aria-label="@settings.SiteName - Trang chủ">
            <img src="~/logo/logo.png" alt="@settings.SiteName" class="main-logo__img" />
        </a>

        @* Right side: utility row + main nav *@
        <div class="header-right">

            @* Row 1: Utility bar *@
            <div class="utility-row">
                <nav class="utility-bar__links" aria-label="Utility links">
                    @await Component.InvokeAsync("Menu", new { key = "top" })
                </nav>
                <div class="utility-bar__right">
                    @if (!string.IsNullOrWhiteSpace(settings.PhoneNumber))
                    {
                        <a href="tel:@settings.PhoneNumber" class="utility-hotline">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/></svg>
                            Hotline @settings.PhoneNumber
                        </a>
                    }
                    <partial name="_LanguageSwitcher" />
                    <button class="utility-search-btn" id="searchToggle" aria-label="Tìm kiếm">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        Tìm kiếm
                    </button>
                </div>
            </div>

            @* Row 2: Main navigation *@
            <nav class="main-nav" aria-label="Điều hướng chính">
                <ul class="main-nav__list">
                    @await Component.InvokeAsync("Menu", new { key = "main" })
                </ul>
            </nav>

        </div>

        @* Mobile toggle *@
        <button class="mobile-menu-btn" id="mobileMenuBtn" aria-label="Menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>

    </div>

    @* Search drawer *@
    <div class="search-drawer" id="searchDrawer" aria-hidden="true">
        <div class="hd-container search-drawer__inner">
            <form action="/search" method="get" class="search-drawer__form" role="search">
                <input type="search" name="q" placeholder="Tìm kiếm sản phẩm, tin tức..."
                       class="search-drawer__input" aria-label="Từ khoá" autocomplete="off" />
                <button type="submit" class="search-drawer__btn" aria-label="Tìm">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                </button>
            </form>
            <button class="search-drawer__close" id="searchClose" aria-label="Đóng">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>
    </div>
</header>

@* Mobile menu *@
<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
    <div class="mobile-menu__overlay" id="mobileOverlay"></div>
    <div class="mobile-menu__panel">
        <div class="mobile-menu__head">
            <img src="~/logo/logo.png" alt="@settings.SiteName" class="mobile-menu__brand-logo" />
            <button class="mobile-menu__close" id="mobileClose" aria-label="Đóng">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>
        <nav class="mobile-menu__nav">
            <a href="/" class="mobile-menu__link">Trang chủ</a>
            @await Component.InvokeAsync("Menu", new { key = "main", view = "mobile" })
        </nav>
        <div class="mobile-menu__foot">
            @if (!string.IsNullOrWhiteSpace(settings.PhoneNumber))
            {
                <a href="tel:@settings.PhoneNumber" class="mobile-menu__hotline">📞 @settings.PhoneNumber</a>
            }
            <partial name="_LanguageSwitcher" />
        </div>
    </div>
</div>

@* Header spacer *@
<div class="hd-spacer"></div>

@* ── MAIN ────────────────────────────────────────────────── *@
<main id="main-content" role="main">
    @RenderBody()
</main>

@* ══════════════════════════════════════════════════════════
   FOOTER
══════════════════════════════════════════════════════════ *@
