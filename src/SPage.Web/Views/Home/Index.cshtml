@* ══════════════════════════════════════════════════════════
   6. SẢN PHẨM NỔI BẬT — tab + product selector + detail (data from DB)
══════════════════════════════════════════════════════════ *@
@{
    var productCategories = ViewBag.ProductCategories as IList<SPage.Application.Features.ProductCategories.DTOs.ProductCategoryDto> ?? new List<SPage.Application.Features.ProductCategories.DTOs.ProductCategoryDto>();
    var productsSection6 = ViewBag.ProductsSection6 as IList<SPage.Application.Features.Products.DTOs.ProductSummaryDto> ?? new List<SPage.Application.Features.Products.DTOs.ProductSummaryDto>();
    var firstProduct = productsSection6.FirstOrDefault();
    var brandColors = new[] { "#eec976", "#37474f", "#2e7d32", "#f57f17", "#b71c1c", "#880e4f", "#6d4c41", "#558b2f", "#6a1b9a", "#1565c0", "#c62828", "#2e7d32" };
}
<section class="ac-section ac-products-section" aria-labelledby="products-title" data-tabs>
    @* Wave top *@
    <div class="ac-wave ac-wave--red-top" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#f5f5f5" d="M0,80 L0,40 C240,-10 480,80 720,40 C960,0 1200,70 1440,30 L1440,80 Z"/>
        </svg>
    </div>
    <div class="ac-products-section__bg">
        <div class="hd-container">
            <h2 class="ac-section-title ac-section-title--red" id="products-title" data-reveal>SẢN PHẨM NỔI BẬT</h2>
            @* Category tabs: TẤT CẢ + danh mục từ DB *@
            <div class="ac-cat-tabs" data-tab-group="products">
                <button class="ac-cat-tab active" data-tab="all">TẤT CẢ</button>
                @foreach (var cat in productCategories)
                {
                    <button class="ac-cat-tab" data-tab="@(cat.Slug ?? "")">@(cat.Name?.ToUpperInvariant() ?? "")</button>
                }
            </div>

            <div class="ac-products-browser" data-reveal data-reveal-delay="100">
                @* Left: product selector (real products) *@
                <div class="ac-brand-selector" id="productSelectorList">
                    @for (var i = 0; i < productsSection6.Count; i++)
                    {
                        var p = productsSection6[i];
                        var abbr = p.Name?.Length >= 2 ? string.Concat(p.Name.Take(2)).ToUpperInvariant() : (p.Name ?? "SP");
                        var color = brandColors[i % brandColors.Length];
                        var detailUrl = Url.Action("Detail", "Products", new { categorySlug = p.CategorySlug ?? "san-pham", productSlug = p.Slug });
                        <button type="button" class="ac-brand-item @(i == 0 ? "active" : "")"
                                data-category-slug="@(p.CategorySlug ?? "")"
                                data-name="@p.Name"
                                data-desc="@(p.ShortDescription ?? "")"
                                data-url="@detailUrl"
                                data-image="@(p.PrimaryImageUrl ?? "")"
                                data-image-alt="@(p.PrimaryImageAlt ?? p.Name)"
                                data-color="@color"
                                data-abbr="@abbr">
                            <div class="ac-brand-item__logo" style="background:@color; color:white">
                                @if (!string.IsNullOrWhiteSpace(p.PrimaryImageUrl))
                                {
                                    <img src="@p.PrimaryImageUrl" alt="@(p.PrimaryImageAlt ?? p.Name)" width="48" height="48" loading="lazy" />
                                }
                                else
                                {
                                    <strong>@abbr</strong>
                                }
                            </div>
                            <span>@p.Name</span>
                        </button>
                    }
                </div>
                @* Right: product detail *@
                <div class="ac-product-detail" id="productDetail">
                    <div class="ac-product-detail__hero" id="productDetailHero" style="background:linear-gradient(135deg,@(firstProduct != null ? brandColors[0] : "#eec976"),@(firstProduct != null ? brandColors[0] : "#9a7e2e")88)">
                        <div id="prodDetailImg" class="ac-product-detail__mock">
                            <img id="prodDetailImgEl" src="@(firstProduct?.PrimaryImageUrl ?? "")" alt="@(firstProduct?.PrimaryImageAlt ?? firstProduct?.Name)" style="@(string.IsNullOrWhiteSpace(firstProduct?.PrimaryImageUrl) ? "display:none" : "")" />
                            <div class="ac-product-detail__mock-label" id="prodDetailAbbr" style="@(!string.IsNullOrWhiteSpace(firstProduct?.PrimaryImageUrl) ? "display:none" : "")">@(firstProduct != null && firstProduct.Name?.Length >= 2 ? string.Concat(firstProduct.Name.Take(2)).ToUpperInvariant() : "SP")</div>
                        </div>
                        <div class="ac-product-detail__info">
                            <h3 id="prodDetailName" class="ac-product-detail__name">@(firstProduct?.Name ?? "Chọn sản phẩm")</h3>
                            <p id="prodDetailDesc" class="ac-product-detail__desc">@(firstProduct?.ShortDescription ?? "")</p>
                        </div>
                        <a href="@(firstProduct != null ? Url.Action("Detail", "Products", new { categorySlug = firstProduct.CategorySlug ?? "san-pham", productSlug = firstProduct.Slug }) : "#")" class="ac-product-detail__link" id="prodDetailLink">
                            Xem chi tiết
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    @* Wave bottom *@
    <div class="ac-wave ac-wave--gray-bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#ffffff" d="M0,30 C360,80 1080,0 1440,50 L1440,80 L0,80 Z"/>
        </svg>
    </div>
</section>

<script>
(function() {
    var tabGroup = document.querySelector('.ac-cat-tabs[data-tab-group="products"]');
    var items = document.querySelectorAll('#productSelectorList .ac-brand-item');
    var detailHero = document.getElementById('productDetailHero');
    var detailName = document.getElementById('prodDetailName');
    var detailDesc = document.getElementById('prodDetailDesc');
    var detailLink = document.getElementById('prodDetailLink');
    var detailImg = document.getElementById('prodDetailImg');
    var detailImgEl = document.getElementById('prodDetailImgEl');
    var detailAbbr = document.getElementById('prodDetailAbbr');

    function filterByTab(tabSlug) {
        var isAll = !tabSlug || tabSlug === 'all';
        items.forEach(function(btn) {
            var catSlug = (btn.getAttribute('data-category-slug') || '').toLowerCase();
            var match = isAll || catSlug === tabSlug.toLowerCase();
            btn.style.display = match ? '' : 'none';
        });
    }

    if (tabGroup) {
        tabGroup.addEventListener('click', function(e) {
            var tab = e.target.closest('.ac-cat-tab');
            if (!tab) return;
            tabGroup.querySelectorAll('.ac-cat-tab').forEach(function(t){ t.classList.remove('active'); });
            tab.classList.add('active');
            filterByTab(tab.getAttribute('data-tab'));
        });
    }

    items.forEach(function(btn) {
        btn.addEventListener('click', function() {
            items.forEach(function(b){ b.classList.remove('active'); });
            btn.classList.add('active');
            var name = btn.getAttribute('data-name') || '';
            var desc = btn.getAttribute('data-desc') || '';
            var url = btn.getAttribute('data-url') || '#';
            var image = btn.getAttribute('data-image') || '';
            var imageAlt = btn.getAttribute('data-image-alt') || name;
            var color = btn.getAttribute('data-color') || '#eec976';
            var abbr = btn.getAttribute('data-abbr') || 'SP';
            if (detailHero) detailHero.style.background = 'linear-gradient(135deg,' + color + ',' + color + '88)';
            if (detailName) detailName.textContent = name;
            if (detailDesc) detailDesc.textContent = desc;
            if (detailLink) { detailLink.href = url; detailLink.style.display = url === '#' ? 'none' : ''; }
            if (detailImg) {
                if (image && detailImgEl) {
                    detailImgEl.src = image;
                    detailImgEl.alt = imageAlt;
                    detailImgEl.style.display = '';
                    if (detailAbbr) detailAbbr.style.display = 'none';
                } else {
                    if (detailImgEl) detailImgEl.style.display = 'none';
                    if (detailAbbr) { detailAbbr.textContent = abbr; detailAbbr.style.display = ''; }
                }
            }
        });
    });
})();
</script>

