@* ══════════════════════════════════════════════════════════
   9. TIN TỨC SỰ KIỆN — featured + list (data từ DB)
══════════════════════════════════════════════════════════ *@
<section class="ac-section ac-news" aria-labelledby="news-title">
    <div class="hd-container">
        <h2 class="ac-section-title ac-section-title--red" id="news-title" data-reveal>TIN TỨC SỰ KIỆN</h2>
        <div class="ac-news-grid">
            @if (recentPosts.Any())
            {
                var featuredPost = recentPosts[0];
                <article class="ac-news-featured" data-reveal-x style="--reveal-x:-40px">
                    <a href="/@featuredPost.Slug" class="ac-news-featured__img-link" aria-label="Tin nổi bật">
                        <div class="ac-news-featured__img" style="@(string.IsNullOrEmpty(featuredPost.FeaturedImageUrl) ? "background:linear-gradient(135deg,#c9a23e,#6d5a10)" : "background:transparent")">
                            @if (!string.IsNullOrEmpty(featuredPost.FeaturedImageUrl))
                            {
                                <img src="@featuredPost.FeaturedImageUrl" alt="@(featuredPost.FeaturedImageAlt ?? featuredPost.Title)" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0" />
                            }
                            <div class="ac-news-featured__overlay">
                                <span class="ac-news-cat ac-news-cat--green">@featuredPost.CategoryName</span>
                                <h3 class="ac-news-featured__title">@featuredPost.Title</h3>
                            </div>
                        </div>
                    </a>
                    <div class="ac-news-featured__meta">
                        <time datetime="@featuredPost.PublishedAt?.ToString("yyyy-MM-dd")">@(featuredPost.PublishedAt?.ToString("dd.MM.yyyy") ?? "")</time>
                        <a href="/@featuredPost.Slug" class="ac-news-featured__read">Đọc tiếp →</a>
                    </div>
                </article>

                <div class="ac-news-list">
                    @foreach (var post in recentPosts.Skip(1))
                    {
                        var imgStyle = string.IsNullOrEmpty(post.FeaturedImageUrl) ? "linear-gradient(135deg,#c9a23e,#eec976)" : "transparent";
                        <article class="ac-news-item" data-reveal>
                            <a href="/@post.Slug" class="ac-news-item__img" style="background:@imgStyle;position:relative;overflow:hidden" aria-hidden="true">
                                @if (!string.IsNullOrEmpty(post.FeaturedImageUrl))
                                {
                                    <img src="@post.FeaturedImageUrl" alt="@(post.FeaturedImageAlt ?? post.Title)" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0" />
                                }
                                else
                                {
                                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1" style="position:relative;z-index:1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                                }
                            </a>
                            <div class="ac-news-item__body">
                                <div class="ac-news-item__meta">
                                    <time>@(post.PublishedAt?.ToString("dd.MM.yyyy") ?? "")</time>
                                    <span class="ac-news-cat ac-news-cat--green">@post.CategoryName</span>
                                </div>
                                <h3 class="ac-news-item__title">
                                    <a href="/@post.Slug">@post.Title</a>
                                </h3>
                            </div>
                        </article>
                    }
                    <a href="@Url.Action("Index", "Posts")" class="ac-news-all-link">Xem tất cả tin tức →</a>
                </div>
            }
            else
            {
                <article class="ac-news-featured" data-reveal-x style="--reveal-x:-40px">
                    <a href="@Url.Action("Index", "Posts")" class="ac-news-featured__img-link">
                        <div class="ac-news-featured__img" style="background:linear-gradient(135deg,#c9a23e,#6d5a10)">
                            <div class="ac-news-featured__overlay">
                                <span class="ac-news-cat ac-news-cat--green">Tin tức</span>
                                <h3 class="ac-news-featured__title">Tin tức &amp; sự kiện</h3>
                            </div>
                        </div>
                    </a>
                    <div class="ac-news-featured__meta">
                        <a href="@Url.Action("Index", "Posts")" class="ac-news-featured__read">Xem tất cả →</a>
                    </div>
                </article>
                <div class="ac-news-list">
                    <a href="@Url.Action("Index", "Posts")" class="ac-news-all-link">Xem tất cả tin tức →</a>
                </div>
            }
        </div>
    </div>
</section>
