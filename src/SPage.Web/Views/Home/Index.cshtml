@using SPage.Application.Common.Interfaces
@using SPage.Application.Features.Products.DTOs
@using SPage.Application.Features.Posts.DTOs
@inject ISiteSettingsService SiteSettingsService
@{
    ViewData["Title"] = "Trang chủ";
    var settings = await SiteSettingsService.GetAsync();
    var featuredProducts = ViewBag.FeaturedProducts as IList<ProductSummaryDto> ?? new List<ProductSummaryDto>();
    var recentPosts = ViewBag.RecentPosts as IList<PostSummaryDto> ?? new List<PostSummaryDto>();
}

@* ══════════════════════════════════════════════════════════
   1. HERO — vàng đồng, wave bottom
══════════════════════════════════════════════════════════ *@
<section class="ac-hero" aria-label="Banner trang chủ">
    <div class="hd-container ac-hero__inner">
        <div class="ac-hero__left">
            <div class="ac-hero__badge">
                <img src="~/logo/logo-40-nam.png" alt="Tân Huê Viên 40 năm" class="ac-hero__badge-logo" />
            </div>
            <h1 class="ac-hero__tagline">
                Đặc Sản <em>Sóc Trăng</em>
            </h1>
            <div class="ac-hero__sub-wrap" style="display:block; min-height:30px; margin-bottom:var(--spacing-8)">
                <p class="ac-hero__sub" style="margin:0">Bánh Pía · Lạp Xưởng · Kẹo — Thương hiệu tin cậy từ năm 1985</p>
            </div>
            <a href="/san-pham" class="ac-btn ac-btn--white">
                Khám phá sản phẩm
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>
        <div class="ac-hero__right" aria-hidden="true">
            <div class="ac-hero__product ac-hero__product--main ac-hero__product--sway">
                <img src="~/images/home/hero-banh-pia-kim-sa.png"
                     alt="Bánh Pía Kim Sa Tân Huê Viên"
                     class="ac-hero__product-img ac-hero__product-img--main" />
            </div>
            <div class="ac-hero__product ac-hero__product--sub ac-hero__product--sway-alt">
                <img src="~/images/home/hero-lap-xuong.png"
                     alt="Lạp Xưởng Tươi Tân Huê Viên"
                     class="ac-hero__product-img ac-hero__product-img--sub" />
            </div>
            <div class="ac-hero__deco-circle ac-hero__deco-circle--1"></div>
            <div class="ac-hero__deco-circle ac-hero__deco-circle--2"></div>
        </div>
    </div>
    @* Wave bottom *@
    <div class="ac-wave" aria-hidden="true">
        <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#ffffff" d="M0,60 C240,110 480,10 720,60 C960,110 1200,20 1440,60 L1440,100 L0,100 Z"/>
        </svg>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   2. PROMO SLIDER — sản phẩm nổi bật (data từ DB)
══════════════════════════════════════════════════════════ *@
<section class="ac-section ac-promos" aria-label="Sản phẩm nổi bật">
    <div class="hd-container">
        <div class="ac-promos__grid">
            @if (featuredProducts.Any())
            {
                var first = featuredProducts[0];
                <a href="/@(first.CategorySlug ?? "san-pham")/@first.Slug" class="ac-promo-card ac-promo-card--lg" data-reveal>
                    <div class="ac-promo-card__content">
                        <img src="~/logo/logo.png" alt="Tân Huê Viên" class="ac-promo-card__brand-logo" />
                        <p class="ac-promo-card__sub">Đặc sản Sóc Trăng</p>
                        <h2 class="ac-promo-card__big">@first.Name</h2>
                        <p class="ac-promo-card__desc">@(first.ShortDescription ?? "Sản phẩm chất lượng từ thương hiệu uy tín.")</p>
                    </div>
                    @if (!string.IsNullOrEmpty(first.PrimaryImageUrl))
                    {
                        <img src="@first.PrimaryImageUrl" alt="@(first.PrimaryImageAlt ?? first.Name)" class="ac-promo-card__img-lg" loading="lazy" />
                    }
                    else
                    {
                        <div class="ac-promo-card__img-lg" style="background:linear-gradient(135deg,#eec976,#9a7e2e);min-height:200px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.8);font-size:3rem;">@first.Name.Substring(0, Math.Min(2, first.Name.Length))</div>
                    }
                </a>
                var delay = 100;
                @foreach (var p in featuredProducts.Skip(1).Take(3))
                {
                    var bg = (delay % 300 == 0) ? "linear-gradient(135deg,#ffebee,#ffcdd2)" : (delay % 200 == 0 ? "linear-gradient(135deg,#e8f5e9,#c8e6c9)" : "linear-gradient(135deg,#fff8e1,#ffe082)");
                    <a href="/@(p.CategorySlug ?? "san-pham")/@p.Slug" class="ac-promo-card ac-promo-card--sm" data-reveal data-reveal-delay="@delay" style="background:@bg">
                        <div class="ac-promo-card__top">
                            @if (p.IsNew) { <p class="ac-promo-card__label">Mới</p> }
                            else if (p.IsPromotion) { <p class="ac-promo-card__label">Khuyến mãi</p> }
                            <h3 class="ac-promo-card__title">@p.Name</h3>
                        </div>
                        @if (!string.IsNullOrEmpty(p.PrimaryImageUrl))
                        {
                            <img src="@p.PrimaryImageUrl" alt="@(p.PrimaryImageAlt ?? p.Name)" class="ac-promo-card__img" loading="lazy" />
                        }
                        else
                        {
                            <div class="ac-promo-card__img" style="background:rgba(255,255,255,0.2);min-height:120px;display:flex;align-items:center;justify-content:center;color:rgba(0,0,0,0.4);font-weight:bold;">@p.Name.Substring(0, Math.Min(2, p.Name.Length))</div>
                        }
                    </a>
                    delay += 100;
                }
            }
            else
            {
                <a href="/san-pham" class="ac-promo-card ac-promo-card--lg" data-reveal>
                    <div class="ac-promo-card__content">
                        <img src="~/logo/logo.png" alt="Tân Huê Viên" class="ac-promo-card__brand-logo" />
                        <p class="ac-promo-card__sub">Đặc sản Sóc Trăng</p>
                        <h2 class="ac-promo-card__big">Sản phẩm</h2>
                        <p class="ac-promo-card__desc">Khám phá các sản phẩm đặc sản của chúng tôi.</p>
                    </div>
                    <div class="ac-promo-card__img-lg" style="background:linear-gradient(135deg,#eec976,#9a7e2e);min-height:200px;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.8);">SP</div>
                </a>
            }
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   3. ABOUT — vàng đồng, text trắng bold + stats
══════════════════════════════════════════════════════════ *@
<section class="ac-about" aria-labelledby="about-title">
    @* Top wave (white → gold) *@
    <div class="ac-wave ac-wave--top" aria-hidden="true">
        <svg viewBox="0 0 1440 80" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#eec976" d="M0,40 C360,-10 1080,80 1440,30 L1440,0 L0,0 Z"/>
        </svg>
    </div>

    <div class="hd-container ac-about__inner">
        <div class="ac-about__left" data-reveal-x style="--reveal-x:-40px">
            <h2 class="ac-about__title" id="about-title">
                THƯƠNG HIỆU<br/>
                ĐẶC SẢN<br/>
                SÓC TRĂNG
            </h2>
            <p class="ac-about__desc">
                Công ty Tân Huê Viên được thành lập từ năm 1985, chuyên sản xuất và kinh doanh các loại bánh kẹo Đặc sản Sóc Trăng. Là một trong những doanh nghiệp đi đầu trong việc bảo tồn truyền thống và không ngừng cải tiến máy móc công nghệ hiện đại, nhằm đưa thương hiệu Tân Huê Viên vươn xa vạn lý.
            </p>
            <a href="/about" class="ac-btn ac-btn--white-outline">
                Xem thêm
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>
        <div class="ac-about__right">
            <div class="ac-stats-grid">
                <div class="ac-stats-photo ac-stats-photo--1">
                    <div class="ac-photo-mock" style="background:linear-gradient(135deg,#c9a23e,#9a7e2e)">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        <span>Nhà máy<br/>hiện đại</span>
                    </div>
                    <div class="ac-stat-badge">
                        <strong>1985</strong>
                        <span>NĂM THÀNH LẬP
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        </span>
                    </div>
                </div>
                <div class="ac-stat-big" data-reveal data-reveal-delay="0">
                    <strong data-count="40" data-suffix="+">40+</strong>
                    <span>NĂM KINH NGHIỆM
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
                    </span>
                </div>
                <div class="ac-stat-big" data-reveal data-reveal-delay="100">
                    <strong data-count="20" data-suffix="+">20+</strong>
                    <span>QUỐC GIA XUẤT KHẨU
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    </span>
                </div>
                <div class="ac-stats-photo ac-stats-photo--2">
                    <div class="ac-photo-mock" style="background:linear-gradient(135deg,#6d4c0f,#c9a23e)">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        <span>Đội ngũ<br/>chuyên nghiệp</span>
                    </div>
                    <div class="ac-stat-badge ac-stat-badge--bottom">
                        <strong>63</strong>
                        <span>TỈNH THÀNH</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Bottom wave (gold → white) *@
    <div class="ac-wave ac-wave--bottom" aria-hidden="true">
        <svg viewBox="0 0 1440 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#ffffff" d="M0,60 C240,110 480,10 720,60 C960,110 1200,20 1440,60 L1440,100 L0,100 Z"/>
        </svg>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
   4. GIỚI THIỆU CÔNG TY — trắng
══════════════════════════════════════════════════════════ *@
<section class="ac-section ac-ceo">
    <div class="hd-container ac-ceo__inner">
        <div class="ac-ceo__text" data-reveal>
            <p class="ac-ceo__body">
                Tân Huê Viên tự hào là doanh nghiệp tiên phong trong việc bảo tồn và phát triển hương vị bánh pía truyền thống Sóc Trăng. Qua hơn 40 năm hình thành, chúng tôi đã không ngừng đổi mới — từ công thức đến dây chuyền sản xuất — để mang đến những sản phẩm đảm bảo chất lượng, an toàn vệ sinh thực phẩm và phong phú hương vị.
            </p>
            <p class="ac-ceo__body">
                Với hệ thống phân phối trải rộng khắp 63 tỉnh thành và xuất khẩu sang hơn 20 quốc gia, chúng tôi hướng đến mục tiêu đưa đặc sản Sóc Trăng vươn ra thế giới, góp phần giới thiệu văn hóa ẩm thực Việt Nam đến bạn bè quốc tế.
            </p>
            <p class="ac-ceo__sign">
                <strong>Công ty TNHH Tân Huê Viên — Từ năm 1985</strong>
            </p>
        </div>
        <div class="ac-ceo__photo" aria-hidden="true" data-reveal-x style="--reveal-x:40px">
            <div class="ac-photo-mock ac-photo-mock--ceo" style="background:linear-gradient(160deg,#fff8e1,#ffe082)">
                <img src="~/logo/logo-40-nam.png" alt="Tân Huê Viên 40 năm" style="width:100%;height:100%;object-fit:contain;border-radius:inherit" />
            </div>
        </div>
    </div>
</section>

@* ══════════════════════════════════════════════════════════
