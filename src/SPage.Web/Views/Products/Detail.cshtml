@using SPage.Application.Features.Products.DTOs
@model ProductDetailDto
@{
    ViewData["Title"] = Model.MetaTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allImages = Model.Images.ToList();
    var hasMultipleImages = allImages.Count > 1;
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
}

<div class="hd-container">
<article itemscope itemtype="https://schema.org/Product" class="product-detail-page" id="main-content">

    <nav aria-label="Breadcrumb" itemscope itemtype="https://schema.org/BreadcrumbList" class="product-detail__breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a itemprop="item" asp-controller="Home" asp-action="Index"><span itemprop="name">Trang chủ</span></a>
                <meta itemprop="position" content="1" />
            </li>
            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <a itemprop="item" asp-controller="Products" asp-action="Index"><span itemprop="name">Sản phẩm</span></a>
                <meta itemprop="position" content="2" />
            </li>
            <li class="breadcrumb-item active" aria-current="page" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                <span itemprop="name">@Model.Name</span>
                <meta itemprop="position" content="3" />
            </li>
        </ol>
    </nav>

    <div class="product-detail__main row g-4 g-lg-5">
        @* Gallery: Carousel + Lightbox *@
        <div class="col-12 col-lg-6">
            <div class="product-detail__gallery">
                @if (allImages.Any())
                {
                    <div id="productGallery" class="carousel slide product-detail__carousel" data-bs-ride="carousel" data-bs-interval="false">
                        <div class="carousel-inner rounded-3 overflow-hidden bg-light">
                            @for (var i = 0; i < allImages.Count; i++)
                            {
                                var img = allImages[i];
                                var img800 = img.ImageUrl800w ?? img.ImageUrl;
                                var imgZoom = img.ImageUrl1200w ?? img800;
                                <div class="carousel-item @(i == 0 ? "active" : "")">
                                    <button type="button"
                                            class="product-detail__main-img-wrap border-0 bg-transparent p-0 w-100"
                                            data-bs-toggle="modal"
                                            data-bs-target="#productLightbox"
                                            data-lightbox-src="@imgZoom"
                                            data-lightbox-alt="@(img.AltText ?? Model.Name)"
                                            aria-label="Phóng to ảnh">
                                        <img src="@img800"
                                             alt="@(img.AltText ?? Model.Name)"
                                             class="product-detail__main-img img-fluid d-block mx-auto"
                                             loading="@(i == 0 ? "eager" : "lazy")"
                                             itemprop="image" />
                                    </button>
                                </div>
                            }
                        </div>
                        @if (hasMultipleImages)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#productGallery" data-bs-slide="prev" aria-label="Ảnh trước">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#productGallery" data-bs-slide="next" aria-label="Ảnh sau">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            </button>
                        }
                    </div>

                    @if (hasMultipleImages)
                    {
                        <div class="product-detail__thumbs mt-3 d-flex gap-2 flex-wrap justify-content-center">
                            @for (var i = 0; i < allImages.Count; i++)
                            {
                                var img = allImages[i];
                                var thumbUrl = img.ImageUrl400w ?? img.ImageUrl;
                                <button type="button"
                                        class="product-detail__thumb border rounded-2 overflow-hidden @(i == 0 ? "active" : "")"
                                        data-bs-target="#productGallery"
                                        data-bs-slide-to="@i"
                                        aria-label="Xem ảnh @(i + 1)">
                                    <img src="@thumbUrl" alt="@(img.AltText ?? Model.Name)" class="img-fluid" loading="lazy" />
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="product-detail__placeholder rounded-3 d-flex align-items-center justify-content-center text-muted">
                        <svg width="80" height="80" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                            <path d="M4 3a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" />
                        </svg>
                    </div>
                }
            </div>
        </div>

        @* Info *@
        <div class="col-12 col-lg-6 d-flex flex-column">
            <div class="product-detail__info">
                <h1 class="product-detail__title" itemprop="name">@Model.Name</h1>
                @if (!string.IsNullOrWhiteSpace(Model.SKU))
                {
                    <p class="product-detail__sku text-muted mb-2">SKU: <span itemprop="sku">@Model.SKU</span></p>
                }

                <div class="product-detail__price-wrap mb-4" itemprop="offers" itemscope itemtype="https://schema.org/Offer">
                    <meta itemprop="priceCurrency" content="VND" />
                    @if (Model.SalePrice.HasValue && Model.SalePrice < Model.Price)
                    {
                        <meta itemprop="price" content="@Model.SalePrice" />
                        <span class="product-detail__price product-detail__price--sale">@Model.SalePrice.Value.ToString("N0") đ</span>
                        <span class="product-detail__price product-detail__price--old text-muted text-decoration-line-through ms-2">@Model.Price.ToString("N0") đ</span>
                    }
                    else
                    {
                        <meta itemprop="price" content="@Model.Price" />
                        <span class="product-detail__price">@Model.Price.ToString("N0") đ</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="product-detail__short-desc text-muted mb-4">@Model.ShortDescription</p>
                }

                <div class="product-detail__actions mt-auto">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary btn-lg">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20" class="me-2"><path fill-rule="evenodd" d="M9.707 14.707a1 1 0 0 1-1.414 0l-4-4a1 1 0 0 1 0-1.414l4-4a1 1 0 0 1 1.414 1.414L7.414 9H15a1 1 0 1 1 0 2H7.414l2.293 2.293a1 1 0 0 1 0 1.414z" clip-rule="evenodd"/></svg>
                        Xem tất cả sản phẩm
                    </a>
                </div>
            </div>
        </div>
    </div>

    @* Mô tả *@
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <section class="product-detail__section">
            <h2 class="product-detail__section-title">Mô tả sản phẩm</h2>
            <div class="prose product-detail__description" itemprop="description">
                @Html.Raw(Model.Description)
            </div>
        </section>
    }

    @* Thông số *@
    @if (Model.Attributes?.Any() == true)
    {
        <section class="product-detail__section">
            <h2 class="product-detail__section-title">Thông số</h2>
            <dl class="product-detail__specs row">
                @foreach (var attr in Model.Attributes)
                {
                    <dt class="col-sm-4 col-md-3 text-muted">@attr.Name</dt>
                    <dd class="col-sm-8 col-md-9 mb-2">@attr.Value</dd>
                }
            </dl>
        </section>
    }
</article>
</div>

@* Lightbox modal — click ảnh để phóng to *@
@if (allImages.Any())
{
    <div class="modal fade" id="productLightbox" tabindex="-1" aria-labelledby="productLightboxLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content product-lightbox__content border-0 bg-transparent shadow-none">
                <div class="modal-header product-lightbox__header border-0 justify-content-end">
                    <button type="button" class="btn-close btn-close-white product-lightbox__close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body product-lightbox__body p-0 text-center">
                    <img id="productLightboxImg" src="" alt="" class="img-fluid product-lightbox__img" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            // Lightbox: hiển thị ảnh phóng to khi click
            var lightbox = document.getElementById('productLightbox');
            if (lightbox) {
                var img = document.getElementById('productLightboxImg');
                lightbox.addEventListener('show.bs.modal', function (e) {
                    var btn = e.relatedTarget;
                    if (btn && btn.dataset.lightboxSrc) {
                        img.src = btn.dataset.lightboxSrc;
                        img.alt = btn.dataset.lightboxAlt || '';
                    }
                });
            }

            // Đồng bộ active thumbnail khi đổi slide
            var gallery = document.getElementById('productGallery');
            var thumbs = document.querySelectorAll('.product-detail__thumb[data-bs-slide-to]');
            if (gallery && thumbs.length) {
                gallery.addEventListener('slid.bs.carousel', function (e) {
                    var idx = e.to;
                    thumbs.forEach(function (t, i) {
                        t.classList.toggle('active', i === idx);
                    });
                });
            }
        })();
    </script>
}
