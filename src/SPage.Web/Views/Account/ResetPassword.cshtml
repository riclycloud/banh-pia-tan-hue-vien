@model SPage.Controllers.ResetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SPage</title>
    <meta name="robots" content="noindex, nofollow" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gray-100 dark:bg-gray-900">

    <div class="w-full max-w-sm p-6 bg-white rounded-2xl shadow-lg dark:bg-gray-800">
        <div class="text-center mb-4">
            <h1 class="text-xl font-bold text-gray-800 dark:text-white">
                Đặt lại mật khẩu
            </h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                Nhập mật khẩu mới cho tài khoản của bạn.
            </p>
        </div>

        <form asp-action="ResetPassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>

            <div>
                <label asp-for="NewPassword" class="block mb-1.5 text-sm font-medium text-gray-700 dark:text-white">
                    Mật khẩu mới
                </label>
                <input asp-for="NewPassword" type="password"
                       class="block w-full px-3 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                <span asp-validation-for="NewPassword" class="text-xs text-red-500 mt-1"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block mb-1.5 text-sm font-medium text-gray-700 dark:text-white">
                    Nhập lại mật khẩu mới
                </label>
                <input asp-for="ConfirmPassword" type="password"
                       class="block w-full px-3 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 mt-1"></span>
            </div>

            <button type="submit"
                    class="w-full py-2.5 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700">
                Lưu mật khẩu mới
            </button>
        </form>
    </div>

</body>
</html>

