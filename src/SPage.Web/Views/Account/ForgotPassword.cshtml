@model SPage.Controllers.ForgotPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Quên mật khẩu";
}

<!DOCTYPE html>
<html lang="vi" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SPage</title>
    <meta name="robots" content="noindex, nofollow" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen flex items-center justify-center bg-gray-100 dark:bg-gray-900">

    <div class="w-full max-w-sm p-6 bg-white rounded-2xl shadow-lg dark:bg-gray-800">
        <div class="text-center mb-6">
            <h1 class="text-xl font-bold text-gray-800 dark:text-white">
                Quên mật khẩu
            </h1>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                Nhập email để nhận liên kết đặt lại mật khẩu.
            </p>
        </div>

        <form asp-action="ForgotPassword" method="post" class="space-y-4">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>

            <div>
                <label asp-for="Email" class="block mb-1.5 text-sm font-medium text-gray-700 dark:text-white">Email</label>
                <input asp-for="Email" type="email" autocomplete="email" autofocus
                       class="block w-full px-3 py-2.5 text-sm bg-gray-50 border border-gray-300 rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1"></span>
            </div>

            <button type="submit"
                    class="w-full py-2.5 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700">
                Gửi link đặt lại mật khẩu
            </button>

            <div class="text-center mt-3">
                <a asp-action="Login" class="text-xs text-gray-500 hover:underline dark:text-gray-300">
                    Quay lại đăng nhập
                </a>
            </div>
        </form>
    </div>

</body>
</html>

