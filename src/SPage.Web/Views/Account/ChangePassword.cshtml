@model SPage.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="max-w-md mx-auto">
    <h2 class="text-xl font-bold text-gray-800 dark:text-white mb-4">
        Đổi mật khẩu
    </h2>

    <form asp-action="ChangePassword" method="post" class="space-y-4">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-sm text-red-500"></div>

        <div>
            <label asp-for="CurrentPassword" class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
                Mật khẩu hiện tại
            </label>
            <input asp-for="CurrentPassword" type="password"
                   class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
            <span asp-validation-for="CurrentPassword" class="text-xs text-red-500 mt-1"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
                Mật khẩu mới
            </label>
            <input asp-for="NewPassword" type="password"
                   class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
            <span asp-validation-for="NewPassword" class="text-xs text-red-500 mt-1"></span>
        </div>

        <div>
            <label asp-for="ConfirmPassword" class="block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300">
                Nhập lại mật khẩu mới
            </label>
            <input asp-for="ConfirmPassword" type="password"
                   class="block w-full px-3 py-2 text-sm bg-white border border-gray-300 rounded-lg dark:bg-gray-700 dark:border-gray-600 dark:text-white" />
            <span asp-validation-for="ConfirmPassword" class="text-xs text-red-500 mt-1"></span>
        </div>

        <button type="submit"
                class="px-4 py-2 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700">
            Lưu mật khẩu
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

