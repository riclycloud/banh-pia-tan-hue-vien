@using SPage.Domain.Entities.Store
@model List<SPage.Controllers.StoreLocationGroupVm>
@{
    ViewData["Title"] = "Đại lý & Địa chỉ cửa hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
}

<div class="hd-container public-page">
    <header class="public-page__header text-center mb-5">
        <h1 class="public-page__title public-page__title--accent">Đại lý & Địa chỉ cửa hàng</h1>
        <p class="public-page__subtitle mb-0">Tìm điểm bán hàng Tân Huê Viên gần bạn — Showroom, đại lý, siêu thị trong nước và quốc tế.</p>
    </header>

        @if (!Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" viewBox="0 0 16 16" class="mb-3 opacity-50">
                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                </svg>
                <p class="mb-0">Đang cập nhật danh sách địa chỉ.</p>
            </div>
        }
        else
        {
            @foreach (var group in Model)
            {
                <section class="store-locations-group mb-5" aria-labelledby="region-@group.RegionType">
                    <h2 id="region-@group.RegionType" class="public-page__title mb-4 pb-2 border-bottom">
                        <span class="d-inline-flex align-items-center gap-2">
                            @if (group.RegionType == StoreRegionType.Domestic)
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>
                            }
                            else
                            {
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16"><circle cx="8" cy="4" r="2"/><path d="M14.763.075A.5.5 0 0 1 15 .5v15a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5V14h-1v1.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .342-.474L6 7.64V4.5a.5.5 0 0 1 .276-.447l8-4a.5.5 0 0 1 .487.022zM6 8.694 1 10.36V15h5V8.694zM7 15h2v-1.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 .5.5V15h2V1.309l-7 3.5V15z"/></svg>
                            }
                            @group.Title
                        </span>
                    </h2>

                    @foreach (var sub in group.SubGroups)
                    {
                        <h3 class="h6 text-uppercase text-muted mb-3 mt-4">@sub.LocationTypeLabel</h3>
                        <div class="row g-4">
                            @foreach (var loc in sub.Locations)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <article class="card h-100 border shadow-sm store-location-card">
                                        <div class="card-body">
                                            <h4 class="card-title h6 mb-2">@loc.Name</h4>
                                            <p class="card-text small text-muted mb-2">
                                                <span class="d-inline-flex align-items-start gap-1">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="mt-0.5 shrink-0"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>
                                                    @loc.FullAddress
                                                </span>
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(loc.ProvinceOrCity) || !string.IsNullOrWhiteSpace(loc.Country))
                                            {
                                                <p class="small text-secondary mb-2">@(loc.ProvinceOrCity), @(loc.Country)</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(loc.LandlinePhone) || !string.IsNullOrWhiteSpace(loc.MobilePhone))
                                            {
                                                <p class="small mb-2">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1 align-middle"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328z"/></svg>
                                                    @if (!string.IsNullOrWhiteSpace(loc.LandlinePhone)) { <span>@loc.LandlinePhone</span> }
                                                    @if (!string.IsNullOrWhiteSpace(loc.LandlinePhone) && !string.IsNullOrWhiteSpace(loc.MobilePhone)) { <span> · </span> }
                                                    @if (!string.IsNullOrWhiteSpace(loc.MobilePhone)) { <a href="tel:@loc.MobilePhone">@loc.MobilePhone</a> }
                                                </p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(loc.ManagerName))
                                            {
                                                <p class="small mb-2"><strong>Liên hệ:</strong> @loc.ManagerName</p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(loc.MapLink))
                                            {
                                                <a href="@loc.MapLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary mt-2">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" class="me-1"><path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm7.5-6.923c-.67.204-1.335.82-1.887 1.855A7.97 7.97 0 0 0 5.145 4H7.5V1.077zM4.09 4a9.267 9.267 0 0 1 .64-1.539 6.7 6.7 0 0 1 .597-.933A7.025 7.025 0 0 0 4.09 4zM3.5 14.5a9.493 9.493 0 0 1-1.607-3.3 6.7 6.7 0 0 1 .657-.94A7.024 7.024 0 0 0 3.5 14.5zm1.5-1.5a6.7 6.7 0 0 1-.94-.657 9.493 9.493 0 0 1-3.3-1.607A7.024 7.024 0 0 0 5 13zm3.5-1.5a6.7 6.7 0 0 1 .657-.94 9.493 9.493 0 0 1 3.3-1.607 7.024 7.024 0 0 0-1.457 2.107A6.7 6.7 0 0 1 10 11.5z"/></svg>
                                                    Xem bản đồ
                                                </a>
                                            }
                                        </div>
                                    </article>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
        }
</div>

<style>
.store-location-card { transition: box-shadow .2s ease, transform .2s ease; }
.store-location-card:hover { box-shadow: 0 .5rem 1rem rgba(0,0,0,.12) !important; }
.store-locations-group h2 { font-weight: 600; }
</style>
